#!/usr/bin/env bash
# Cockpit-native memory map. Reads Intercom memory/cockpit.mmd; fail closed.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
for lib_candidate in \
  "$script_root/../../bin/cockpit-lib" \
  "$HOME/.local/bin/cockpit-lib"; do
  if [[ -f "$lib_candidate" ]]; then
    # shellcheck source=/dev/null
    source "$lib_candidate"
    break
  fi
done

INTERCOM_HOME="${COCKPIT_INTERCOM_HOME:-$HOME/intercom}"
MEMORY_FILE="${COCKPIT_MEMORY_FILE:-$INTERCOM_HOME/memory/cockpit.mmd}"
REQUIRED_SUBGRAPHS=(index intercom hooks)
FORBIDDEN_PATTERNS=(
  '/workspace/aspects'
  Foundry
  PiSai
  MBA
)

usage() {
  cat <<'EOF'
Usage: memory COMMAND

Render and validate the Cockpit memory map from Intercom.

Commands:
  status                show memory file path and availability
  validate              exit 0 when the file exists and passes checks
  render                print the rendered memory map to stdout
  handshake             one-shot launch readiness marker

Environment:
  COCKPIT_INTERCOM_HOME Intercom clone root (default: ~/intercom)
  COCKPIT_MEMORY_FILE   override diagram path
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

memory_path() {
  printf '%s\n' "$MEMORY_FILE"
}

memory_missing() {
  [[ ! -f "$MEMORY_FILE" ]]
}

read_memory() {
  memory_missing && die "memory file missing: $MEMORY_FILE"
  cat -- "$MEMORY_FILE"
}

validate_memory() {
  local content subgraph missing=0
  if memory_missing; then
    printf 'memory_file=missing\n'
    printf 'path=%s\n' "$MEMORY_FILE"
    return 1
  fi
  content="$(cat -- "$MEMORY_FILE")"
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if grep -Fq "$pattern" <<<"$content"; then
      printf 'memory_file=forbidden\n'
      printf 'path=%s\n' "$MEMORY_FILE"
      printf 'reason=forbidden pattern: %s\n' "$pattern"
      return 1
    fi
  done
  for subgraph in "${REQUIRED_SUBGRAPHS[@]}"; do
    if ! grep -Eiq "subgraph[[:space:]]+${subgraph}([[:space:]]|\[|\")" <<<"$content"; then
      missing=1
      printf 'missing_subgraph=%s\n' "$subgraph"
    fi
  done
  if ((missing)); then
    printf 'memory_file=invalid\n'
    printf 'path=%s\n' "$MEMORY_FILE"
    return 1
  fi
  printf 'memory_file=ok\n'
  printf 'path=%s\n' "$MEMORY_FILE"
  return 0
}

render_memory() {
  local plugin renderer
  validate_memory >/dev/null
  plugin="$script_root/../../bin/cockpit-showmegraphs"
  [[ -x "$plugin" ]] || plugin="$HOME/.local/bin/cockpit-showmegraphs"
  renderer="${COCKPIT_MAP_RENDERER:-showmegraphs}"
  case "$renderer" in
    showmegraphs|show-me|auto)
      if [[ -x "$plugin" ]]; then
        "$plugin" "$MEMORY_FILE"
        return 0
      fi
      if command -v mermaid-ascii >/dev/null 2>&1; then
        mermaid-ascii -f "$MEMORY_FILE" -x 2 -y 1
        return 0
      fi
      ;;
    mermaid-ascii)
      if command -v mermaid-ascii >/dev/null 2>&1; then
        mermaid-ascii -f "$MEMORY_FILE" -x 2 -y 1
        return 0
      fi
      ;;
  esac
  cat -- "$MEMORY_FILE"
}

handshake() {
  if validate_memory; then
    printf 'handshake=ready\n'
    printf 'slice=memory\n'
    printf 'launch=once\n'
    return 0
  fi
  printf 'handshake=blocked\n'
  printf 'slice=memory\n'
  printf 'launch=once\n'
  return 1
}

command=${1:-status}
shift || true
case "$command" in
  status)
    printf 'intercom_home=%s\n' "$INTERCOM_HOME"
    if memory_missing; then
      printf 'memory_file=missing\n'
      printf 'path=%s\n' "$MEMORY_FILE"
      exit 1
    fi
    printf 'memory_file=present\n'
    printf 'path=%s\n' "$MEMORY_FILE"
    validate_memory >/dev/null
    printf 'memory_file=valid\n'
    ;;
  validate) validate_memory ;;
  render) render_memory ;;
  handshake) handshake ;;
  -h|--help) usage ;;
  *) die "Unknown memory command: $command" ;;
esac
