#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
which="${2:-}"

[[ -n "$session" && "$session" == codex-cockpit* ]] || exit 0
[[ -n "$which" ]] || exit 0

case "$which" in
  DIFF|diff) name=DIFF ;;
  FILES|files) name=FILES ;;
  MAP|map|MERMAID|mermaid) name=MAP ;;
  *) exit 0 ;;
esac

pidfile="${XDG_RUNTIME_DIR:-/tmp}/codex-cockpit/${session}/${name}.pid"
[[ -f "$pidfile" ]] || exit 0
pid="$(cat "$pidfile" 2>/dev/null || true)"
[[ -n "$pid" && -d "/proc/$pid" ]] || exit 0
kill -USR1 "$pid" 2>/dev/null || true
