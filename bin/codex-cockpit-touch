#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
view="${2:-runtime}"

if [[ -z "$session" ]]; then
  exit 0
fi
if ! tmux has-session -t "$session" 2>/dev/null; then
  exit 0
fi

role=$view
case "$view" in
  runtime|codex|agent|CODEX) role=runtime; window=CODEX ;;
  files|FILES|nvim) role=files; window=FILES ;;
  diff|DIFF) role=diff; window=DIFF ;;
  map|mermaid|MAP|MERMAID) role=map; window=MAP ;;
  prs|PRS|github) role=prs; window=PRS ;;
  help|HELP) exec tmux display-popup -t "$session" -E -w 90% -h 90% -T "Codex Cockpit" "codex-cockpit-help" ;;
  *) exit 0 ;;
esac

tmux set-option -t "$session" @cockpit_last "$view" >/dev/null 2>&1 || true

if [[ "$role" == "prs" ]]; then
  tmux select-window -t "$session:PRS" 2>/dev/null || \
    tmux new-window -t "$session:" -n PRS -c "#{pane_current_path}" "exec codex-cockpit-prs"
  exit 0
fi

pane="$(
  tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk -v r="$role" '$2 == r { print $1; exit }'
)"

if [[ -n "$pane" ]]; then
  tmux select-window -t "$pane"
  tmux select-pane -t "$pane"
  pane_count="$(tmux display-message -p -t "$pane" '#{window_panes}')"
  zoomed="$(tmux display-message -p -t "$pane" '#{window_zoomed_flag}')"
  if [[ "${pane_count:-1}" -gt 1 && "$zoomed" != "1" ]]; then
    tmux resize-pane -Z -t "$pane"
  fi
  codex-cockpit-wake "$session" "$window" || true
  exit 0
fi

tmux select-window -t "$session:$window" 2>/dev/null || true
