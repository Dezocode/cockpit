#!/usr/bin/env bash
# Cockpit outbound notify — single sender for CLI and /api/notify.
set -euo pipefail

if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
  echo "cockpit-notify: bash 4+ required" >&2
  exit 2
fi

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=cockpit-lib
source "$script_root/cockpit-lib"

cn_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit"
cn_receipt_file="$cn_state_dir/notify.jsonl"
cn_config_file="$(cockpit_config_home)/notify.conf"

cn_redact() {
  local s=$1
  s="${s//${COCKPIT_TELEGRAM_BOT_TOKEN:-}/***}"
  s="${s//${COCKPIT_NTFY_TOPIC:-}/***}"
  s="${s//${COCKPIT_NTFY_TOKEN:-}/***}"
  s="${s//${COCKPIT_NOTIFY_KEY:-}/***}"
  s="${s//${COCKPIT_TELEGRAM_CHAT_ID:-}/***}"
  printf '%s' "$s" | sed -E \
    -e 's/bot[0-9]+:[A-Za-z0-9_-]+/***/g' \
    -e 's/Bearer [^[:space:]]+/Bearer ***/g'
}

cn_sha256() {
  printf '%s' "$1" | openssl dgst -sha256 2>/dev/null | awk '{print $NF}'
}

cn_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n' | sed 's/\(........\)\(....\)\(....\)\(....\)\(............\)/\1-\2-\3-\4-\5/'
  fi
}

cn_load_notify_env() {
  if [[ -f /etc/cockpit/notify.env && -r /etc/cockpit/notify.env ]]; then
    # shellcheck disable=SC1091
    set -a
    # shellcheck source=/dev/null
    source /etc/cockpit/notify.env
    set +a
  fi
}

cn_maybe_keys_reexec() {
  if [[ -n "${COCKPIT_NOTIFY_KEYS_LOADED:-}" ]]; then
    return 0
  fi
  if [[ -n "${COCKPIT_TELEGRAM_BOT_TOKEN:-}${COCKPIT_NTFY_TOPIC:-}${COCKPIT_NOTIFY_KEY:-}" ]]; then
    return 0
  fi
  if [[ -x "$script_root/cockpit-keys" ]]; then
    export COCKPIT_NOTIFY_KEYS_LOADED=1
    exec "$script_root/cockpit-keys" exec --for notify -- "$script_root/cockpit-notify" "$@"
  fi
}

cn_read_conf() {
  cn_order="telegram,ntfy,desktop"
  cn_default_title="Cockpit"
  cn_dedupe_window_s=600
  if [[ -f "$cn_config_file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      [[ -z "$line" ]] && continue
      case "$line" in
        order=*) cn_order="${line#order=}" ;;
        default_title=*) cn_default_title="${line#default_title=}" ;;
        dedupe_window_s=*) cn_dedupe_window_s="${line#dedupe_window_s=}" ;;
      esac
    done <"$cn_config_file"
  fi
}

cn_usage() {
  cat <<'EOF'
Usage: cockpit notify [--title T] [--sink auto|telegram|ntfy|desktop|all] [--require SINK]
                      [--priority low|default|high] [--link URL] [--id ID] [--json] [--dry-run]
                      [--check] [--via local|api] [--] MESSAGE... | -

Deliver a plain-text notification via Telegram, ntfy, or desktop toast.
EOF
}

cn_priority_num() {
  case "${1:-default}" in
    low) printf '2' ;;
    high) printf '4' ;;
    *) printf '3' ;;
  esac
}

cn_desktop_available() {
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    command -v notify-send >/dev/null 2>&1 && return 0
  fi
  command -v osascript >/dev/null 2>&1 && return 0
  return 1
}

cn_telegram_ready() {
  if command -v hermes >/dev/null 2>&1; then
    return 0
  fi
  if [[ -z "${COCKPIT_TELEGRAM_BOT_TOKEN:-}" || -z "${COCKPIT_TELEGRAM_CHAT_ID:-}" ]]; then
    return 1
  fi
  local base="${COCKPIT_TELEGRAM_API_BASE:-https://api.telegram.org}"
  local url="${base}/bot${COCKPIT_TELEGRAM_BOT_TOKEN}/getMe"
  local out rc
  out="$(curl --silent --show-error --max-time 10 --config <(printf 'url = "%s"\n' "$(cn_curl_escape "$url")") 2>&1)" || rc=$?
  [[ "${rc:-0}" -eq 0 ]] && printf '%s' "$out" | grep -q '"ok":true'
}

cn_ntfy_configured() {
  [[ -n "${COCKPIT_NTFY_TOPIC:-}" ]]
}

cn_curl_escape() {
  local v=$1
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '%s' "$v"
}

cn_sink_hermes() {
  local text=$1
  hermes send --to telegram -q "$text"
}

cn_sink_botapi() {
  local text=$1
  local base="${COCKPIT_TELEGRAM_API_BASE:-https://api.telegram.org}"
  local token="${COCKPIT_TELEGRAM_BOT_TOKEN:?}"
  local chat="${COCKPIT_TELEGRAM_CHAT_ID:?}"
  local url="${base}/bot${token}/sendMessage"
  local body_len=${#text}
  if ((body_len > 4000)); then
    text="${text:0:3997}..."
  fi
  local cfg
  cfg="$(mktemp "${TMPDIR:-/tmp}/cockpit-notify-curl.XXXXXX")"
  {
    printf 'url = "%s"\n' "$(cn_curl_escape "$url")"
    printf 'request = "POST"\n'
    printf 'data-urlencode = "chat_id=%s"\n' "$(cn_curl_escape "$chat")"
    printf 'data-urlencode = "text=%s"\n' "$(cn_curl_escape "$text")"
    printf 'data-urlencode = "disable_web_page_preview=true"\n'
  } >"$cfg"
  curl --silent --show-error --max-time 10 --config "$cfg"
  rm -f "$cfg"
}

cn_sink_ntfy() {
  local title=$1 msg=$2 pri=$3 link=${4:-}
  local server="${COCKPIT_NTFY_SERVER:-https://ntfy.sh}"
  local topic="${COCKPIT_NTFY_TOPIC:?}"
  local url="${server%/}/${topic}"
  local cfg
  cfg="$(mktemp "${TMPDIR:-/tmp}/cockpit-notify-ntfy.XXXXXX")"
  {
    printf 'url = "%s"\n' "$(cn_curl_escape "$url")"
    printf 'request = "POST"\n'
    printf 'header = "Title: %s"\n' "$(cn_curl_escape "$title")"
    printf 'header = "Priority: %s"\n' "$pri"
    printf 'header = "Tags: cockpit"\n'
    if [[ -n "$link" ]]; then
      printf 'header = "Click: %s"\n' "$(cn_curl_escape "$link")"
    fi
    if [[ -n "${COCKPIT_NTFY_TOKEN:-}" ]]; then
      printf 'header = "Authorization: Bearer %s"\n' "$(cn_curl_escape "$COCKPIT_NTFY_TOKEN")"
    fi
    printf 'data = "%s"\n' "$(cn_curl_escape "$msg")"
  } >"$cfg"
  curl --silent --show-error --max-time 10 --config "$cfg"
  rm -f "$cfg"
}

cn_sink_desktop() {
  local title=$1 msg=$2
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a Cockpit -u normal -- "$title" "$msg"
    return 0
  fi
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' \
      -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' -- "$title" "$msg"
    return 0
  fi
  return 1
}

cn_find_dedupe() {
  local id=$1
  [[ -z "$id" || ! -f "$cn_receipt_file" ]] && return 1
  local now cutoff line ts
  now=$(date +%s)
  cutoff=$((now - cn_dedupe_window_s))
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    printf '%s' "$line" | grep -q "\"id\":\"$id\"" || continue
    ts="$(printf '%s' "$line" | sed -n 's/.*"ts":\([0-9]*\).*/\1/p')"
    [[ -n "$ts" && "$ts" -ge "$cutoff" ]] && { printf '%s' "$line"; return 0; }
  done <"$cn_receipt_file"
  return 1
}

cn_write_receipt() {
  local id=$1 via=$2 title=$3 msg=$4 delivered=$5 sinks_json=$6 deduped=${7:-false}
  mkdir -p "$cn_state_dir"
  local ts preview hash
  ts=$(date +%s)
  preview="$(printf '%s' "$msg" | head -c 80)"
  preview="$(cn_redact "$preview")"
  hash="$(cn_sha256 "$msg")"
  local line
  line="$(printf '{"ts":%s,"id":"%s","via":"%s","title":"%s","message_sha256":"%s","preview":"%s","sinks":%s,"delivered":"%s","deduped":%s}' \
    "$ts" "$id" "$via" "$(cn_redact "$title" | sed 's/"/\\"/g')" "$hash" "$(printf '%s' "$preview" | sed 's/"/\\"/g')" \
    "$sinks_json" "$delivered" "$deduped")"
  printf '%s\n' "$line" >>"$cn_receipt_file"
  printf '%s' "$line"
}

cn_format_sinks_kv() {
  local tg=${1:-} nt=${2:-} dk=${3:-}
  printf 'telegram:%s,ntfy:%s,desktop:%s' "$tg" "$nt" "$dk"
}

cn_remote_configured() {
  command -v hermes >/dev/null 2>&1 && return 0
  [[ -n "${COCKPIT_TELEGRAM_BOT_TOKEN:-}${COCKPIT_NTFY_TOPIC:-}" ]]
}

cn_post_api() {
  local url="${COCKPIT_NOTIFY_URL:?}"
  local key="${COCKPIT_NOTIFY_KEY:?}"
  local payload
  payload="$(python3 -c 'import json,sys; print(json.dumps({"message":sys.argv[1],"title":sys.argv[2]}))' "$cn_message" "$cn_title")"
  local out code
  out="$(curl --silent --show-error --max-time 20 \
    -w '\n%{http_code}' \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $key" \
    -d "$payload" \
    "$url")" || return 4
  code="${out##*$'\n'}"
  out="${out%$'\n'*}"
  case "$code" in
    200) printf '%s' "$out"; return 0 ;;
    401) return 4 ;;
    429) return 5 ;;
    *) printf '%s' "$out" >&2; return 3 ;;
  esac
}

cn_run_check() {
  local tg nt dk
  if command -v hermes >/dev/null 2>&1; then
    tg=ready
  elif [[ -n "${COCKPIT_TELEGRAM_BOT_TOKEN:-}" && -n "${COCKPIT_TELEGRAM_CHAT_ID:-}" ]]; then
    if cn_telegram_ready; then tg=ready; else tg=invalid; fi
  else
    tg=not-configured
  fi
  if cn_ntfy_configured; then nt=configured; else nt=not-configured; fi
  if cn_desktop_available; then dk=available; else dk=headless; fi
  if [[ -n "${cn_json:-}" ]]; then
    printf '{"telegram":"%s","ntfy":"%s","desktop":"%s"}\n' "$tg" "$nt" "$dk"
  else
    printf 'telegram:%s ntfy:%s desktop:%s\n' "$tg" "$nt" "$dk"
  fi
}

cn_deliver_local() {
  local id=$1
  local tg_st=skip:not-configured nt_st=skip:not-configured dk_st=skip:headless
  local delivered=none remote_done=0
  local pri_n; pri_n="$(cn_priority_num "$cn_priority")"
  local full_msg="$cn_message"
  [[ -n "${cn_link:-}" ]] && full_msg="${cn_message}"$'\n'"${cn_link}"

  if [[ -n "${cn_dry_run:-}" ]]; then
    cn_write_receipt "$id" "$cn_via" "$cn_title" "$cn_message" dry-run '{"telegram":"dry-run:ok","ntfy":"dry-run:ok","desktop":"dry-run:ok"}' false >/dev/null
    if [[ -n "${cn_json:-}" ]]; then
      printf '{"delivered":"dry-run","sinks":{"telegram":"dry-run:ok","ntfy":"dry-run:ok","desktop":"dry-run:ok"},"id":"%s"}\n' "$id"
    else
      printf 'notify: delivered=dry-run sinks=dry-run:ok id=%s\n' "$id"
    fi
    return 0
  fi

  cn_try_telegram() {
    if command -v hermes >/dev/null 2>&1; then
      if cn_sink_hermes "$full_msg" >/dev/null 2>&1; then
        tg_st=ok; return 0
      fi
      tg_st="fail:hermes"
      return 1
    fi
    if [[ -n "${COCKPIT_TELEGRAM_BOT_TOKEN:-}" && -n "${COCKPIT_TELEGRAM_CHAT_ID:-}" ]]; then
      if cn_sink_botapi "$full_msg" 2>/dev/null | grep -q '"ok":true'; then
        tg_st=ok; return 0
      fi
      tg_st="fail:botapi"
      return 1
    fi
    tg_st=skip:not-configured
    return 1
  }

  cn_try_ntfy() {
    if ! cn_ntfy_configured; then
      nt_st=skip:not-configured
      return 1
    fi
    if cn_sink_ntfy "$cn_title" "$full_msg" "$pri_n" "${cn_link:-}" >/dev/null 2>&1; then
      nt_st=ok
      return 0
    fi
    nt_st=fail:ntfy
    return 1
  }

  cn_try_desktop() {
    if cn_sink_desktop "$cn_title" "$full_msg" >/dev/null 2>&1; then
      dk_st=ok
      return 0
    fi
    dk_st=skip:headless
    return 1
  }

  case "$cn_sink" in
    all)
      cn_try_telegram || true
      cn_try_ntfy || true
      cn_try_desktop || true
      [[ "$tg_st" == ok ]] && delivered=telegram
      [[ "$delivered" == none && "$nt_st" == ok ]] && delivered=ntfy
      [[ "$delivered" == none && "$dk_st" == ok ]] && delivered=desktop
      ;;
    telegram)
      cn_try_telegram && delivered=telegram || true
      ;;
    ntfy)
      cn_try_ntfy && delivered=ntfy || true
      ;;
    desktop)
      cn_try_desktop && delivered=desktop || true
      ;;
    auto)
      local tried_tg=0 tried_nt=0
      IFS=',' read -ra order_parts <<<"$cn_order"
      for part in "${order_parts[@]}"; do
        part="$(printf '%s' "$part" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ "$remote_done" -eq 1 ]] && break
        case "$part" in
          telegram)
            tried_tg=1
            if cn_try_telegram; then remote_done=1; delivered=telegram; fi
            ;;
          ntfy)
            tried_nt=1
            if cn_try_ntfy; then remote_done=1; delivered=ntfy; fi
            ;;
          desktop) ;;
        esac
      done
      if [[ "$tried_tg" -eq 0 ]]; then tg_st=skip:not-configured; fi
      if [[ "$tried_nt" -eq 0 ]]; then nt_st=skip:not-configured; fi
      if [[ "$remote_done" -eq 1 && "$delivered" == telegram && "$tried_nt" -eq 0 ]]; then
        nt_st=skip:telegram-ok
      fi
      if [[ "$remote_done" -eq 1 && "$delivered" == ntfy && "$tried_tg" -eq 0 ]]; then
        tg_st=skip:ntfy-ok
      fi
      cn_try_desktop || true
      [[ "$remote_done" -eq 0 && "$dk_st" == ok ]] && delivered=desktop
      ;;
  esac

  if [[ -n "${cn_require:-}" ]]; then
    case "$cn_require" in
      telegram) [[ "$tg_st" != ok ]] && delivered=none ;;
      ntfy) [[ "$nt_st" != ok ]] && delivered=none ;;
      desktop) [[ "$dk_st" != ok ]] && delivered=none ;;
    esac
  fi

  local sinks_json
  sinks_json="$(printf '{"telegram":"%s","ntfy":"%s","desktop":"%s"}' "$tg_st" "$nt_st" "$dk_st")"
  cn_write_receipt "$id" "$cn_via" "$cn_title" "$cn_message" "$delivered" "$sinks_json" false >/dev/null

  if [[ "$delivered" == none ]]; then
    return 3
  fi

  if [[ -n "${cn_json:-}" ]]; then
    printf '{"delivered":"%s","sinks":{"telegram":"%s","ntfy":"%s","desktop":"%s"},"id":"%s"}\n' \
      "$delivered" "$tg_st" "$nt_st" "$dk_st" "$id"
  else
    printf 'notify: delivered=%s sinks=%s id=%s\n' \
      "$delivered" "$(cn_format_sinks_kv "$tg_st" "$nt_st" "$dk_st")" "$id"
  fi
  return 0
}

cn_main() {
  # shellcheck disable=SC2145
  : "${@+}" # ensure argv present
  cn_maybe_keys_reexec "$@"
  cn_load_notify_env
  cn_read_conf

  cn_title="$cn_default_title"
  cn_sink=auto
  cn_priority=default
  cn_via=
  cn_via_explicit=
  cn_json=
  cn_dry_run=
  cn_check=
  cn_require=
  cn_link=
  cn_id=
  cn_message=

  local args=("$@")
  local i=0
  while ((i < ${#args[@]})); do
    case "${args[i]}" in
      -h|--help) cn_usage; exit 0 ;;
      --title) cn_title="${args[i+1]:-}"; i=$((i + 2)) ;;
      --sink) cn_sink="${args[i+1]:-}"; i=$((i + 2)) ;;
      --require) cn_require="${args[i+1]:-}"; i=$((i + 2)) ;;
      --priority) cn_priority="${args[i+1]:-}"; i=$((i + 2)) ;;
      --link) cn_link="${args[i+1]:-}"; i=$((i + 2)) ;;
      --id) cn_id="${args[i+1]:-}"; i=$((i + 2)) ;;
      --json) cn_json=1; i=$((i + 1)) ;;
      --dry-run) cn_dry_run=1; i=$((i + 1)) ;;
      --check) cn_check=1; i=$((i + 1)) ;;
      --via) cn_via="${args[i+1]:-}"; cn_via_explicit=1; i=$((i + 2)) ;;
      --)
        i=$((i + 1))
        cn_message="$(printf '%s ' "${args[@]:i}")"
        cn_message="${cn_message% }"
        i=${#args[@]}
        break
        ;;
      -) cn_message="$(cat)"; i=${#args[@]}; break ;;
      *)
        cn_message="$(printf '%s ' "${args[@]:i}")"
        cn_message="${cn_message% }"
        i=${#args[@]}
        break
        ;;
    esac
  done

  if [[ -z "$cn_message" ]] && ((i < ${#args[@]})); then
    cn_message="$(printf '%s ' "${args[@]:i}")"
    cn_message="${cn_message% }"
  fi

  if [[ -n "${COCKPIT_NOTIFY_DRY_RUN:-}" ]]; then
    cn_dry_run=1
  fi

  if [[ -n "$cn_check" ]]; then
    cn_run_check
    exit 0
  fi

  cn_message="$(printf '%s' "$cn_message" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  if [[ -z "$cn_message" ]]; then
    cn_usage >&2
    exit 2
  fi

  if [[ -z "$cn_via_explicit" ]]; then
    if cn_remote_configured; then
      cn_via=local
    elif [[ -n "${COCKPIT_NOTIFY_URL:-}" ]]; then
      cn_via=api
    else
      cn_via=local
    fi
  else
    cn_via="${cn_via:-local}"
  fi

  local id="${cn_id:-$(cn_uuid)}"

  local prev
  if prev="$(cn_find_dedupe "$id")"; then
    if [[ -n "${cn_json:-}" ]]; then
      printf '%s' "$prev" | sed 's/}$/,"deduped":true}/'
    else
      local del sinks_line
      del="$(printf '%s' "$prev" | sed -n 's/.*"delivered":"\([^"]*\)".*/\1/p')"
      sinks_line="$(printf '%s' "$prev" | sed -n 's/.*"sinks":{\([^}]*\)}.*/\1/p' | tr ',' ' ' | sed 's/"//g' | tr ' ' ',')"
      printf 'notify: delivered=%s sinks=%s id=%s deduped=true\n' "$del" "$sinks_line" "$id"
    fi
    exit 0
  fi

  if [[ "$cn_via" == api ]]; then
    local api_out rc=0
    api_out="$(cn_post_api)" || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      [[ -n "${cn_json:-}" ]] && printf '%s\n' "$api_out" || printf '%s\n' "$api_out"
      exit 0
    fi
    exit "$rc"
  fi

  if [[ "$cn_via" == local ]] && ! cn_remote_configured && [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && [[ -n "${COCKPIT_NOTIFY_URL:-}" ]]; then
    cn_via=api
    cn_post_api || exit $?
    exit 0
  fi

  cn_deliver_local "$id" || exit 3
}

cn_main "$@"
