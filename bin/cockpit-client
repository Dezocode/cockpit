#!/usr/bin/env python3
"""Run an interactive command while normalizing Termius SGR mouse input.

Some Termius/touch paths emit valid-looking SGR mouse packets with a negative
Y coordinate, for example ``ESC [ < 0;35;-24M``. tmux rejects those packets and
passes them to the pane as literal input. This small PTY bridge changes only
the invalid Y coordinate to the first screen row before tmux sees it. All
other input and output is forwarded byte-for-byte.
"""

from __future__ import annotations

import errno
import fcntl
import os
import pty
import re
import select
import signal
import struct
import sys
import termios
import tty
from typing import Optional


SGR_PREFIX = b"\x1b[<"
SGR_EVENT = re.compile(
    rb"\x1b\[<([0-9]+);([+-]?[0-9]+);([+-]?[0-9]+)([Mm])$"
)


def suffix_prefix_length(data: bytes) -> int:
    """Return the longest suffix that can begin an SGR mouse packet."""

    max_len = min(len(data), len(SGR_PREFIX) - 1)
    for length in range(max_len, 0, -1):
        if data[-length:] == SGR_PREFIX[:length]:
            return length
    return 0


class SGRNormalizer:
    """Incrementally rewrite only SGR mouse events with Y <= 0."""

    def __init__(self) -> None:
        self.pending = b""

    def feed(self, data: bytes) -> bytes:
        self.pending += data
        output = bytearray()

        while self.pending:
            start = self.pending.find(SGR_PREFIX)
            if start < 0:
                keep = suffix_prefix_length(self.pending)
                if keep:
                    output.extend(self.pending[:-keep])
                    self.pending = self.pending[-keep:]
                else:
                    output.extend(self.pending)
                    self.pending = b""
                break

            if start:
                output.extend(self.pending[:start])
                self.pending = self.pending[start:]

            end_upper = self.pending.find(b"M", len(SGR_PREFIX))
            end_lower = self.pending.find(b"m", len(SGR_PREFIX))
            ends = [end for end in (end_upper, end_lower) if end >= 0]
            if not ends:
                break

            end = min(ends)
            raw = self.pending[: end + 1]
            match = SGR_EVENT.fullmatch(raw)
            if match is not None:
                y = int(match.group(3))
                if y <= 0:
                    raw = (
                        b"\x1b[<"
                        + match.group(1)
                        + b";"
                        + match.group(2)
                        + b";1"
                        + match.group(4)
                    )
            output.extend(raw)
            self.pending = self.pending[end + 1 :]

        return bytes(output)

    def flush(self) -> bytes:
        remainder = self.pending
        self.pending = b""
        return remainder


def get_winsize(fd: int) -> Optional[tuple[int, int]]:
    try:
        raw = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, _, _ = struct.unpack("HHHH", raw)
    except OSError:
        return None
    if rows <= 0 or cols <= 0:
        return None
    return rows, cols


def set_winsize(fd: int, size: Optional[tuple[int, int]]) -> None:
    if size is None:
        return
    rows, cols = size
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
    except OSError:
        pass


def write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except InterruptedError:
            continue
        if written <= 0:
            return
        view = view[written:]


def main(argv: list[str]) -> int:
    if not argv:
        print("usage: cockpit client COMMAND [ARG ...]", file=sys.stderr)
        return 2

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()
    if not os.isatty(stdin_fd) or not os.isatty(stdout_fd):
        os.execvp(argv[0], argv)

    original = termios.tcgetattr(stdin_fd)
    child_pid, master_fd = pty.fork()
    if child_pid == 0:
        os.execvp(argv[0], argv)

    set_winsize(master_fd, get_winsize(stdin_fd))
    tty.setraw(stdin_fd)
    normalizer = SGRNormalizer()
    old_winch = signal.getsignal(signal.SIGWINCH)
    old_forward: dict[int, object] = {}

    def on_winch(_signum: int, _frame: object) -> None:
        size = get_winsize(stdin_fd)
        set_winsize(master_fd, size)
        try:
            os.kill(child_pid, signal.SIGWINCH)
        except ProcessLookupError:
            pass

    def forward(signum: int, _frame: object) -> None:
        try:
            os.kill(child_pid, signum)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGWINCH, on_winch)
    for signum in (signal.SIGHUP, signal.SIGTERM):
        old_forward[signum] = signal.getsignal(signum)
        signal.signal(signum, forward)

    status: Optional[int] = None
    try:
        while True:
            try:
                waited_pid, waited_status = os.waitpid(child_pid, os.WNOHANG)
            except ChildProcessError:
                waited_pid, waited_status = child_pid, 0
            if waited_pid == child_pid:
                status = waited_status
                break

            try:
                readable, _, _ = select.select([stdin_fd, master_fd], [], [], 0.25)
            except InterruptedError:
                continue

            if stdin_fd in readable:
                try:
                    data = os.read(stdin_fd, 65536)
                except OSError as exc:
                    if exc.errno == errno.EIO:
                        data = b""
                    else:
                        raise
                if not data:
                    try:
                        os.kill(child_pid, signal.SIGHUP)
                    except ProcessLookupError:
                        pass
                    break
                normalized = normalizer.feed(data)
                if normalized:
                    write_all(master_fd, normalized)

            if master_fd in readable:
                try:
                    data = os.read(master_fd, 65536)
                except OSError as exc:
                    if exc.errno == errno.EIO:
                        data = b""
                    else:
                        raise
                if not data:
                    break
                write_all(stdout_fd, data)
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, original)
        signal.signal(signal.SIGWINCH, old_winch)
        for signum, handler in old_forward.items():
            signal.signal(signum, handler)
        try:
            os.close(master_fd)
        except OSError:
            pass

    if status is None:
        try:
            _, status = os.waitpid(child_pid, 0)
        except ChildProcessError:
            status = 0
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
