#!/usr/bin/env bash
# Read-only health audit for a running Cockpit session.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
authlib="$script_root/cockpit-auth-lib"
theme_lib="$script_root/cockpit-lib"
# shellcheck source=cockpit-agent-lib
agentlib="$script_root/cockpit-agent-lib"
# shellcheck source=cockpit-auth-lib
source "$authlib"
# shellcheck source=cockpit-agent-lib
source "$agentlib"
# shellcheck source=cockpit-lib
source "$theme_lib"

session="$(cockpit_session_name)"
if [[ "${1:-}" == "--session" ]]; then
  session="${2:-$session}"
elif [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
  session="$1"
fi

green="$(cockpit_theme_style green '' 0)"
red="$(cockpit_theme_style red '' 0)"
blue="$(cockpit_theme_style accent '' 0)"
muted="$(cockpit_theme_muted)"
bright="$(cockpit_theme_style foreground '' 1)"
reset="$(cockpit_theme_reset)"

passes=0
warnings=0
failures=0

pass_check() {
  passes=$((passes + 1))
  printf '  %sOK%s     %s\n' "$green" "$reset" "$*"
}

warn_check() {
  warnings=$((warnings + 1))
  printf '  %sWARN%s   %s\n' "$blue" "$reset" "$*"
}

fail_check() {
  failures=$((failures + 1))
  printf '  %sFAIL%s   %s\n' "$red" "$reset" "$*"
}

has_command() {
  command -v "$1" >/dev/null 2>&1
}

plugin_catalog_health() {
  local json installed available
  if ! has_command codex; then
    warn_check 'Codex plugin catalog skipped (codex CLI missing)'
    return 0
  fi
  if ! has_command jq; then
    warn_check 'Codex plugin catalog skipped (jq missing)'
    return 0
  fi
  if has_command timeout; then
    json="$(timeout 1.5s codex plugin list --available --json 2>/dev/null || true)"
  else
    json="$(codex plugin list --available --json 2>/dev/null || true)"
  fi
  if [[ -z "$json" ]] || ! jq -e '(.installed? // []) and (.available? // [])' \
    >/dev/null 2>&1 <<<"$json"; then
    warn_check 'Codex plugin catalog is unavailable'
    return 0
  fi
  installed="$(jq -r '
    [((.installed // [])[]?), ((.available // [])[]? | select(.installed == true))]
    | map(select(.pluginId? != null)) | unique_by(.pluginId) | length
  ' <<<"$json")"
  available="$(jq -r '[((.available // [])[]? | select(.installed != true))] | length' \
    <<<"$json")"
  pass_check "Codex plugins: ${installed} installed, ${available} available"
}

cockpit_plugin_health() {
  local rows
  if ! has_command cockpit-plugin; then
    warn_check 'Cockpit-native plugin registry is not installed'
    return 0
  fi
  rows="$(cockpit-plugin list 2>/dev/null || true)"
  if grep -Eq '^cockpit\.cpr[[:space:]]+type=cockpit[[:space:]]+version=' <<<"$rows"; then
    pass_check 'Cockpit CPR native plugin is available'
  else
    fail_check 'Cockpit CPR native plugin is missing or invalid'
  fi
  if grep -Eq '^cockpit\.memory[[:space:]]+type=cockpit[[:space:]]+version=' <<<"$rows"; then
    pass_check 'Cockpit MEMORY native plugin is available'
  else
    fail_check 'Cockpit MEMORY native plugin is missing or invalid'
  fi
  if grep -Eq '^cockpit\.computers[[:space:]]+type=cockpit[[:space:]]+version=' <<<"$rows"; then
    pass_check 'Cockpit COMPUTERS native plugin is available'
  else
    fail_check 'Cockpit COMPUTERS native plugin is missing or invalid'
  fi
  if grep -Eq '^cockpit\.intercom[[:space:]]+type=cockpit[[:space:]]+version=' <<<"$rows"; then
    pass_check 'Cockpit INTERCOM native plugin is available'
  else
    fail_check 'Cockpit INTERCOM native plugin is missing or invalid'
  fi
}

native_project_plugin_health() {
  local plugin_root manifest marketplace skill_count hook_count json installed
  plugin_root="$script_root/../plugins/cockpit-native"
  manifest="$plugin_root/.codex-plugin/plugin.json"
  marketplace="$script_root/../.agents/plugins/marketplace.json"
  if [[ ! -f "$manifest" || ! -f "$marketplace" ]]; then
    warn_check 'Native Cockpit project plugin manifests are incomplete'
    return 0
  fi
  if has_command python3 &&
    python3 /home/dezocode/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py \
      "$plugin_root" >/dev/null 2>&1; then
    pass_check 'Native Cockpit plugin manifest validates'
  else
    fail_check 'Native Cockpit plugin manifest is invalid'
  fi
  skill_count="$(find "$plugin_root/skills" -mindepth 2 -maxdepth 2 -type f -name SKILL.md \
    -print 2>/dev/null | wc -l)"
  hook_count="$(awk '/^\[\[hook\]\]/{n++} END {print n + 0}' \
    "$script_root/../.codex/hooks/cockpit-hooks.toml" 2>/dev/null || printf '0')"
  if [[ "$skill_count" -ge 10 ]]; then
    pass_check "Native Cockpit project skills: $skill_count"
  else
    fail_check "Native Cockpit project skills: $skill_count; expected at least 10"
  fi
  if [[ "$hook_count" -ge 10 ]]; then
    pass_check "Native Cockpit project hook workflows: $hook_count"
  else
    fail_check "Native Cockpit project hook workflows: $hook_count; expected at least 10"
  fi
  if has_command jq && has_command codex; then
    if has_command timeout; then
      json="$(timeout 1.5s codex plugin list --json 2>/dev/null || true)"
    else
      json="$(codex plugin list --json 2>/dev/null || true)"
    fi
    installed="$(jq -r '[.installed[]? | select(.pluginId == "cockpit-native@personal" and .enabled == true)] | length' \
      <<<"$json" 2>/dev/null || printf '0')"
    if [[ "$installed" -ge 1 ]]; then
      pass_check 'Native Cockpit plugin is installed and enabled in Codex'
    else
      warn_check 'Native Cockpit plugin is available in the project but not enabled in Codex'
    fi
  else
    warn_check 'Native Cockpit plugin activation check skipped (codex or jq missing)'
  fi
}

intercom_source_health() {
  local state
  if ! has_command cockpit-intercom; then
    fail_check 'Intercom readiness gate is not installed'
    return 0
  fi
  state="$(COCKPIT_INTERCOM_ROOT="$HOME/intercom" cockpit-intercom status --summary 2>/dev/null || true)"
  if [[ "$state" == ready ]]; then
    pass_check 'Intercom sync gate is ready'
  else
    fail_check "Intercom sync gate is ${state:-unavailable}"
  fi
}

memory_source_health() {
  local file name
  file="$HOME/intercom/memory/cockpit.mmd"
  if [[ ! -f "$file" ]]; then
    fail_check 'MEMORY source is missing from ~/intercom/memory/cockpit.mmd'
    return 0
  fi
  for name in index intercom handshake hooks; do
    if grep -Eq "^[[:space:]]*subgraph[[:space:]]+${name}([[:space:]]|\\[)" "$file"; then
      pass_check "MEMORY source contains ${name} subgraph"
    else
      fail_check "MEMORY source is missing ${name} subgraph"
    fi
  done
}

computers_source_health() {
  local file source_label
  file="$HOME/intercom/models/deck.json"
  source_label='~/intercom/models/deck.json'
  if [[ ! -f "$file" ]]; then
    file="$HOME/intercom/computers/receipt.tsv"
    source_label='~/intercom/computers/receipt.tsv'
  fi
  if [[ ! -f "$file" ]]; then
    fail_check 'COMPUTERS receipt is missing from ~/intercom/models/deck.json (or the legacy TSV fallback)'
    return 0
  fi
  if COCKPIT_INTERCOM_HOME="$HOME/intercom" computers check >/dev/null 2>&1; then
    pass_check "COMPUTERS receipt validates (intercom-managed source: $source_label)"
  else
    fail_check "COMPUTERS receipt is present but invalid: $source_label"
  fi
}

page_topology_health() {
  local spec name role pane parent count
  for spec in "FILES:files" "DIFF:diff" "MAP:map" "SETUP:setup" "PRS:prs" "MEMORY:memory" "COMPUTERS:computers"; do
    name=${spec%%:*}
    role=${spec##*:}
    pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role} #{window_name}' 2>/dev/null |
      awk -v r="$role" -v n="$name" '$2 == r || ($2 == "" && $3 == n) { print $1; exit }')"
    if [[ -z "$pane" ]]; then
      fail_check "${name} page pane is missing"
      continue
    fi
    parent="$(tmux display-message -p -t "$pane" '#{window_name}' 2>/dev/null || true)"
    count="$(tmux display-message -p -t "$pane" '#{window_panes}' 2>/dev/null || true)"
    if [[ "$parent" != "$name" ]]; then
      fail_check "${name} page is nested in ${parent:-an unknown window}"
    elif [[ "$count" != 1 ]]; then
      fail_check "${name} page has ${count:-unknown} panes; expected one"
    else
      pass_check "${name} page is a single top-level pane"
    fi
  done
}

client_health() {
  local count pid profile
  count="$(tmux list-clients -t "$session" -F '#{client_pid}' 2>/dev/null | sed '/^$/d' | wc -l)"
  if [[ "$count" != 1 ]]; then
    fail_check "Foot sole-client contract: ${count} attached clients"
    return 0
  fi
  pid="$(tmux list-clients -t "$session" -F '#{client_pid}' 2>/dev/null | head -1)"
  profile="$(cockpit-profile "$pid" 2>/dev/null || true)"
  if [[ "$profile" == foot ]]; then
    pass_check 'Foot is the sole attached Cockpit client'
  else
    fail_check "Foot sole-client contract is unmet: ${profile:-unknown} client"
  fi
}

agent_target_health() {
  local runtime_pane root provider state missing
  runtime_pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk '$2 == "runtime" { print $1; exit }')"
  [[ -n "$runtime_pane" ]] || return 0
  root="$(tmux display-message -p -t "$runtime_pane" '#{pane_current_path}' 2>/dev/null || true)"
  provider="$(tmux show-options -v -t "$session" @cockpit_runtime 2>/dev/null || true)"
  [[ -n "$root" && -n "$provider" ]] || return 0
  cockpit_agent_inspect "$root" "$provider" || true
  state="${COCKPIT_AGENT_TARGET_STATE:-unknown}"
  missing="${COCKPIT_AGENT_MISSING_SKILLS:-}"
  case "$state" in
    valid)
      if [[ -n "$missing" ]]; then
        warn_check "Agent target ${COCKPIT_AGENT_TARGET_REL} is valid; missing profile skills: ${missing}"
      else
        pass_check "${provider} targets ${COCKPIT_AGENT_TARGET_REL}; profile is synchronized"
      fi
      ;;
    missing)
      warn_check "${provider} has no project .codex/.agent instruction target"
      ;;
    home-scope)
      warn_check 'Agent target validation skipped for HOME scope'
      ;;
    *)
      fail_check "${provider} agent target ${state}: ${COCKPIT_AGENT_ERROR:-validation failed}"
      ;;
  esac
}

worktree_session_health() {
  local runtime_pane runtime_path runtime_root bound_root branch worktree_path
  runtime_pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk '$2 == "runtime" { print $1; exit }')"
  [[ -n "$runtime_pane" ]] || return 0
  runtime_path="$(tmux display-message -p -t "$runtime_pane" '#{pane_current_path}' 2>/dev/null || true)"
  runtime_root="$(git -C "$runtime_path" rev-parse --show-toplevel 2>/dev/null || true)"
  bound_root="$(tmux show-options -v -t "$session" @cockpit_git_worktree_path 2>/dev/null || true)"
  branch="$(tmux show-options -v -t "$session" @cockpit_git_branch 2>/dev/null || true)"
  worktree_path="$(tmux show-options -v -t "$session" @cockpit_project_root 2>/dev/null || true)"
  if [[ -n "$runtime_root" && -n "$bound_root" && "$runtime_root" == "$bound_root" ]]; then
    pass_check "Git worktree is bound to ${branch:-unborn}"
  elif [[ -z "$bound_root" ]]; then
    warn_check 'Git worktree binding metadata is not initialized for this session'
  else
    fail_check "Git worktree binding ${bound_root} differs from runtime ${runtime_root:-$runtime_path}"
  fi
  if [[ -n "$worktree_path" && -n "$runtime_root" && "$worktree_path" == "$runtime_root" ]]; then
    pass_check 'Project root and runtime worktree agree'
  elif [[ -z "$worktree_path" ]]; then
    warn_check 'Project root binding is not initialized for this session'
  fi
}

printf '%sCOCKPIT AUDIT%s  ·  session=%s\n\n' "$bright" "$reset" "$session"

printf '%sCOMMANDS%s\n' "$bright" "$reset"
for command in tmux nvim codex gh grok; do
  if has_command "$command"; then
    pass_check "$command CLI available"
  else
    fail_check "$command CLI missing"
  fi
done

printf '\n%sAUTH · PROVIDER-OWNED PROBES%s\n' "$bright" "$reset"
cockpit_auth_ensure_config
for id in github codex grok; do
  state="$(cockpit_auth_state "$id" 2>/dev/null || true)"
  case "$state" in
    ready) pass_check "$(cockpit_auth_label "$id") authenticated" ;;
    auth-needed) fail_check "$(cockpit_auth_label "$id") CLI present but authentication is not ready" ;;
    cli-missing) fail_check "$(cockpit_auth_label "$id") CLI missing or provider is not configured" ;;
    *) fail_check "$(cockpit_auth_label "$id") probe returned no usable state" ;;
  esac
done

printf '\n%sSESSION TOPOLOGY%s\n' "$bright" "$reset"
if ! has_command tmux || ! tmux has-session -t "$session" 2>/dev/null; then
  fail_check "tmux session is not running: $session"
else
  pass_check "tmux session is running: $session"
  expected_windows='AGENT FILES DIFF MAP SETUP PRS MEMORY COMPUTERS'
  actual_windows="$(tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | paste -sd' ' -)"
  if [[ "$actual_windows" == "$expected_windows" ]]; then
    pass_check 'eight named Cockpit pages are ordered in the bar'
  else
    fail_check "named page bar is ${actual_windows:-empty}; expected ${expected_windows}"
  fi
  for window in AGENT FILES DIFF MAP SETUP PRS MEMORY COMPUTERS; do
    if tmux list-windows -t "$session" -F '#W' 2>/dev/null | grep -Fxq "$window"; then
      pass_check "window $window exists"
    else
      fail_check "window $window is missing"
    fi
  done

  map_win="$(tmux display-message -p -t "$session:MAP" '#{window_id}' 2>/dev/null || true)"
  memory_in_map=0
  if [[ -n "$map_win" ]]; then
    while read -r role window; do
      [[ "$role" == memory && "$window" == "$map_win" ]] && memory_in_map=1
    done < <(tmux list-panes -s -t "$session" -F '#{@cockpit_role} #{window_id}' 2>/dev/null || true)
  fi
  if ((memory_in_map == 0)); then
    pass_check 'MEMORY is not nested inside MAP'
  else
    fail_check 'MEMORY is nested inside MAP (must be a named page)'
  fi

  runtime_pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk '$2 == "runtime" { print $1; exit }')"
  setup_pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk '$2 == "setup" { print $1; exit }')"
  bar_pane="$(tmux show-options -v -t "$session" @cockpit_bar_pane 2>/dev/null || true)"
  if [[ -n "$runtime_pane" ]]; then
    pass_check 'live Agent pane is tagged runtime'
  else
    fail_check 'live Agent pane is not tagged runtime'
  fi
  if [[ -n "$setup_pane" ]]; then
    setup_version="$(tmux show-options -p -v -t "$setup_pane" @cockpit_setup_version 2>/dev/null || true)"
    if [[ "$setup_version" == 5 ]]; then
      pass_check 'SETUP pane is the persistent v5 flow'
    else
      fail_check "SETUP pane version is ${setup_version:-missing}, expected 5"
    fi
  else
    fail_check 'SETUP pane is not tagged setup'
  fi
  if [[ -n "$bar_pane" ]] && [[ "$(tmux show-options -p -v -t "$bar_pane" @cockpit_role 2>/dev/null || true)" == bar ]]; then
    pass_check 'Agent toolbar pane is tagged bar'
  else
    fail_check 'Agent toolbar pane is missing or untagged'
  fi

  modality="$(tmux show-options -v -t "$session" @cockpit_modality 2>/dev/null || true)"
  profile="$(tmux show-options -v -t "$session" @cockpit_profile 2>/dev/null || true)"
  runtime_id="$(tmux show-options -v -t "$session" @cockpit_runtime 2>/dev/null || true)"
  [[ -n "$modality" ]] && pass_check "modality recorded: $modality" || warn_check 'modality is not recorded'
  [[ -n "$profile" ]] && pass_check "endpoint profile recorded: $profile" || warn_check 'endpoint profile is not recorded'
  [[ -n "$runtime_id" ]] && pass_check "active runtime recorded: $runtime_id" || fail_check 'active runtime is not recorded'
  agent_target_health
  worktree_session_health
  page_topology_health
  client_health
  if ! tmux list-keys -T root 2>/dev/null | grep -Eqi '(^|[[:space:]])F10[[:space:]]'; then
    pass_check 'F10 is not a Cockpit page binding'
  else
    fail_check 'F10 is still bound as a Cockpit page action'
  fi
  memory_source_health
  computers_source_health
  intercom_source_health
fi

printf '\n%sPLUGIN CATALOG%s\n' "$bright" "$reset"
cockpit_plugin_health
native_project_plugin_health
plugin_catalog_health

printf '\n%sRESULT%s  %s passed · %s warnings · %s failures\n' \
  "$bright" "$reset" "$passes" "$warnings" "$failures"
if ((failures > 0)); then
  exit 1
fi
