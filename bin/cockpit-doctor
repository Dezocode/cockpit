#!/usr/bin/env bash
# Thin shim → ported GEV doctor (app/server/gev/doctor.mjs).
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v node >/dev/null 2>&1; then
  echo "cockpit doctor: node is required. Install Node 22+ from https://nodejs.org" >&2
  exit 1
fi
exec node "$root/app/server/gev/doctor.mjs" "$@"
