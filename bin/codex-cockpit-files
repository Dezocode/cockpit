#!/usr/bin/env bash
set -euo pipefail

lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-lib"
# shellcheck source=codex-cockpit-lib
source "$lib"

root="${1:-$PWD}"
root="$(cd -- "$root" && pwd -P)"
session="$(tmux display-message -p '#{session_name}' 2>/dev/null || echo unknown)"
listen="${XDG_RUNTIME_DIR}/codex-cockpit-nvim.$$.sock"
last_path=""
COCKPIT_DEBOUNCE=0.30

cleanup() {
  if [[ -n "${watcher_pid:-}" ]]; then
    kill "$watcher_pid" 2>/dev/null || true
  fi
  rm -f "$listen"
  rm -f "$(cockpit_wake_dir "$session")/FILES.pid"
}
trap cleanup EXIT

printf '\033[2J\033[H'
printf '\033[38;5;4mFILES\033[0m  idle\n\n'
printf 'Neovim starts when you open this tab.\n'

cockpit_install_wake "$session" FILES
while ((COCKPIT_WAKE == 0)) && ! cockpit_view_visible; do
  sleep 0.5 || true
done

open_in_nvim() {
  local path=$1 lua_path
  [[ -S "$listen" ]] || return 0
  [[ -f "$path" ]] || return 0
  lua_path=${path//\\/\\\\}
  lua_path=${lua_path//\"/\\\"}
  nvim --server "$listen" --remote-send \
    "<Cmd>lua CodexCockpitOpen(\"${lua_path}\")<CR>" >/dev/null 2>&1 || true
}

follow_edits() {
  local path extra
  [[ "$root" == "$HOME" ]] && return 0
  command -v inotifywait >/dev/null 2>&1 || return 0
  cockpit_install_wake "$session" FILES

  while true; do
    if IFS= read -r -t 0.5 path; then
      cockpit_coalesce
      while IFS= read -r -t 0.01 extra; do
        path=$extra
      done || true
      cockpit_is_noise_path "$path" && continue
      cockpit_is_text_ext "$path" || continue
      [[ -f "$path" ]] || continue
      last_path=$path
      if cockpit_view_visible; then
        open_in_nvim "$path"
      fi
    else
      if ((COCKPIT_WAKE == 1)); then
        COCKPIT_WAKE=0
        if [[ -n "$last_path" ]] && cockpit_view_visible; then
          open_in_nvim "$last_path"
        else
          nvim --server "$listen" --remote-send "<Cmd>checktime<CR>" >/dev/null 2>&1 || true
        fi
      fi
    fi
  done < <(
    inotifywait -m -q -r \
      -e close_write,moved_to \
      --exclude "$cockpit_noise_exclude" \
      --format '%w%f' \
      "$root" 2>/dev/null
  )
}

follow_edits &
watcher_pid=$!

exec nvim --listen "$listen" .
