#!/usr/bin/env bash
set -euo pipefail

lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/cockpit-lib"
# shellcheck source=cockpit-lib
source "$lib"
script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

root="${1:-$PWD}"
diagram="${2:-}"
root="$(cd -- "$root" && pwd -P)"
session="$(tmux display-message -p '#{session_name}' 2>/dev/null || echo unknown)"
COCKPIT_DEBOUNCE=0.25
last_fp=""
dirty=1

project_name="$(basename -- "$root")"

find_diagram() {
  local found
  if [[ -n "$diagram" && -f "$diagram" ]]; then
    printf '%s\n' "$diagram"
    return 0
  fi
  if [[ -f "$root/docs/architecture.mmd" ]]; then
    printf '%s\n' "$root/docs/architecture.mmd"
    return 0
  fi
  found="$(find "$root" -maxdepth 3 \( -name '*.mmd' -o -name '*.mermaid' \) \
    ! -path '*/.git/*' ! -path '*/node_modules/*' 2>/dev/null | head -1 || true)"
  if [[ -n "$found" ]]; then
    printf '%s\n' "$found"
    return 0
  fi
  return 1
}

# Canon map of this cockpit session for the current project. No host paths.
write_canon_diagram() {
  local dest=$1
  mkdir -p "$(dirname -- "$dest")"
  cat >"$dest" <<EOF
flowchart TB
  subgraph project ["${project_name}"]
    runtime[AGENT]
    files[FILES]
    diff[DIFF]
    map[MAP]
    prs[PRS]
  end
  runtime -->|edits| files
  runtime -->|edits| diff
  files --> map
  prs --> runtime
EOF
}

ensure_diagram() {
  local found dest
  if found="$(find_diagram)"; then
    diagram="$found"
    return 0
  fi
  dest="$root/docs/architecture.mmd"
  write_canon_diagram "$dest"
  diagram="$dest"
}

if [[ -n "$diagram" && "$diagram" != /* ]]; then
  diagram="$root/${diagram#./}"
fi

clear_screen() {
  printf '\033[2J\033[H'
}

header() {
  printf '%sMAP%s  %sSHOWMEGRAPHS%s  %s%s%s\n\n' \
    "$(cockpit_theme_heading)" "$(cockpit_theme_reset)" \
    "$(cockpit_theme_style accent '' 1)" "$(cockpit_theme_reset)" \
    "$(cockpit_theme_muted)" "${diagram:-*.mmd}" "$(cockpit_theme_reset)"
}

file_fp() {
  local path=$1
  [[ -f "$path" ]] || { printf 'missing\n'; return 0; }
  stat -c '%Y %s' "$path" 2>/dev/null
}

render_graph() {
  local plugin="$script_root/cockpit-showmegraphs"
  local renderer="${COCKPIT_MAP_RENDERER:-showmegraphs}"

  case "$renderer" in
    showmegraphs|show-me|auto)
      if [[ -x "$plugin" ]]; then
        "$plugin" "$diagram"
        return 0
      fi
      if command -v mermaid-ascii >/dev/null 2>&1; then
        mermaid-ascii -f "$diagram" -x 2 -y 1
        return 0
      fi
      if command -v merman-cli >/dev/null 2>&1; then
        merman-cli render "$diagram" --format unicode --output -
        return 0
      fi
      ;;
    mermaid-ascii)
      if command -v mermaid-ascii >/dev/null 2>&1; then
        mermaid-ascii -f "$diagram" -x 2 -y 1
        return 0
      fi
      ;;
    merman-cli)
      if command -v merman-cli >/dev/null 2>&1; then
        merman-cli render "$diagram" --format unicode --output -
        return 0
      fi
      ;;
  esac

  printf '%s\n' "$(cat "$diagram")"
  printf '\n%s(ascii renderer optional: mermaid-ascii)%s\n' \
    "$(cockpit_theme_muted)" "$(cockpit_theme_reset)"
}

render() {
  local fp cols
  ensure_diagram
  fp="$(file_fp "${diagram:-}")"
  if [[ "$fp" == "$last_fp" && -n "$last_fp" && -n "$diagram" ]]; then
    dirty=0
    return 0
  fi
  last_fp=$fp
  dirty=0

  clear_screen
  header

  if [[ -z "$diagram" || ! -f "$diagram" ]]; then
    printf 'No Mermaid file in this project.\n'
    return 0
  fi
  cols="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null || echo 80)"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
  render_graph || cat "$diagram"
}

maybe_render() {
  if cockpit_view_visible; then
    render
  else
    dirty=1
  fi
}

if [[ "$root" == "$HOME" ]]; then
  while true; do sleep 3600; done
fi

ensure_diagram
watch_dir="$(dirname -- "$diagram")"
[[ -d "$watch_dir" ]] || watch_dir="$root"

cockpit_event_open "$session" MAP
trap 'cockpit_event_close; rm -f "$(cockpit_wake_dir "$session")/MAP.pid"' EXIT

if cockpit_view_visible; then
  render
else
  dirty=1
  printf '\033[2J\033[H'
  printf '%sMAP%s  idle\n\n' "$(cockpit_theme_heading)" "$(cockpit_theme_reset)"
  printf 'Diagram renders when you open this tab.\n'
fi

cockpit_event_watch "$watch_dir" \
  -e close_write,moved_to,create,delete \
  --exclude "$cockpit_noise_exclude"
if [[ "$watch_dir" != "$root" ]]; then
  cockpit_event_watch "$root" \
    -e create,moved_to \
    --exclude "$cockpit_noise_exclude"
fi

while cockpit_event_read; do
  if [[ "$COCKPIT_EVENT" == "WAKE" ]]; then
    last_fp=""
    maybe_render
    continue
  fi
  sleep "$COCKPIT_DEBOUNCE"
  cockpit_event_drain >/dev/null
  base="${COCKPIT_EVENT##*/}"
  case "$base" in
    *.mmd|*.mermaid|WAKE)
      if [[ "$base" != WAKE && -z "$diagram" ]]; then
        diagram="$COCKPIT_EVENT"
        [[ "$diagram" == /* ]] || diagram="$watch_dir/$base"
      fi
      last_fp=""
      maybe_render
      ;;
    *)
      if [[ "$COCKPIT_EVENT" == "$diagram" || "$base" == "$(basename -- "${diagram:-}")" ]]; then
        last_fp=""
        maybe_render
      fi
      ;;
  esac
done
