# shellcheck shell=bash
# Portable primitives for Cockpit (bash 3.2-safe). Sourced only; no side effects on load.
# Feature-detect GNU/BSD tools; never branch on uname for control flow.

: "${COCKPIT_WATCH_BACKEND:=}"
COCKPIT_BACKEND_INOTIFY=inotifywait
COCKPIT_BACKEND_FSWATCH=fswatch
COCKPIT_BACKEND_NONE=none

_cockpit_stat_gnu=0
if stat -c %Y / >/dev/null 2>&1; then
  _cockpit_stat_gnu=1
fi

_cockpit_has_realpath=0
if command -v realpath >/dev/null 2>&1; then
  _cockpit_has_realpath=1
fi

_cockpit_has_inotify=0
if command -v inotifywait >/dev/null 2>&1; then
  _cockpit_has_inotify=1
fi

_cockpit_has_fswatch=0
if command -v fswatch >/dev/null 2>&1; then
  _cockpit_has_fswatch=1
fi

_cockpit_date_gnu=0
if date -u -d '1970-01-01T00:00:10Z' +%s >/dev/null 2>&1; then
  _cockpit_date_gnu=1
fi

_cockpit_has_path_helper=0
if [[ -x /usr/libexec/path_helper ]]; then
  _cockpit_has_path_helper=1
fi

cockpit_watch_backend() {
  if [[ -n "${COCKPIT_WATCH_BACKEND:-}" ]]; then
    printf '%s\n' "$COCKPIT_WATCH_BACKEND"
    return 0
  fi
  if [[ "$_cockpit_has_inotify" == 1 ]]; then
    printf '%s\n' "$COCKPIT_BACKEND_INOTIFY"
  elif [[ "$_cockpit_has_fswatch" == 1 ]]; then
    printf '%s\n' "$COCKPIT_BACKEND_FSWATCH"
  else
    printf '%s\n' "$COCKPIT_BACKEND_NONE"
  fi
}

cockpit_require_bash4() {
  if [[ "${BASH_VERSINFO[0]:-0}" -ge 4 ]]; then
    # Landed on bash >= 4: drop the loop flag so children decide for
    # themselves. A child started via `env bash` with /bin/bash (3.2) first on
    # PATH (tmux panes, plugins, fixtures) must re-exec too, not inherit a
    # "done" flag and die on the first bash-4-only builtin.
    unset COCKPIT_BASH_REEXEC
    return 0
  fi
  if [[ "${COCKPIT_BASH_REEXEC:-}" == 1 ]]; then
    # A re-exec already happened and still landed on bash < 4: stop, no loop.
    unset COCKPIT_BASH_REEXEC
    printf 'cockpit: bash >= 4 required. Install: brew install bash\n' >&2
    exit 64
  fi
  local candidate entry idx
  # Re-exec the user-invoked entrypoint (e.g. bin/cockpit-agent-config), not an
  # intermediate sourced file (cockpit-lib), and preserve the original argv.
  idx=$((${#BASH_SOURCE[@]} - 1))
  entry="${BASH_SOURCE[$idx]:-${BASH_SOURCE[1]:-$0}}"
  for candidate in ${COCKPIT_BASH4_CANDIDATES:-/opt/homebrew/bin/bash /usr/local/bin/bash}; do
    if [[ -x "$candidate" && "$candidate" != "$BASH" ]]; then
      # Scoped to the re-exec'd process only; exporting breaks child entrypoints
      # (e.g. CPR plugin) that still run under /bin/bash 3.2 via shebang. The
      # re-exec'd process clears it again in the bash >= 4 branch above.
      exec env COCKPIT_BASH_REEXEC=1 "$candidate" "$entry" "$@"
    fi
  done
  printf 'cockpit: bash >= 4 required. Install: brew install bash\n' >&2
  exit 64
}

cockpit_stat_mtime_size() {
  local path
  for path in "$@"; do
    [[ -e "$path" ]] || continue
    if [[ "$_cockpit_stat_gnu" == 1 ]]; then
      stat -c '%n %Y %s' -- "$path" 2>/dev/null
    else
      local mtime size name
      name="$path"
      mtime="$(stat -f '%m' -- "$path" 2>/dev/null || echo 0)"
      size="$(stat -f '%z' -- "$path" 2>/dev/null || echo 0)"
      printf '%s %s %s\n' "$name" "$mtime" "$size"
    fi
  done
}

cockpit_stat_mode() {
  local path=$1
  if [[ "$_cockpit_stat_gnu" == 1 ]]; then
    stat -c '%a' -- "$path" 2>/dev/null
  else
    stat -f '%OLp' -- "$path" 2>/dev/null
  fi
}

cockpit_copy_mode() {
  local src=$1 dst=$2
  if [[ "$_cockpit_stat_gnu" == 1 ]]; then
    local mode_gnu
    mode_gnu="$(stat -c '%a' -- "$src" 2>/dev/null || true)"
    [[ -n "$mode_gnu" ]] && chmod "$mode_gnu" "$dst" 2>/dev/null && return 0
  fi
  local mode
  mode="$(cockpit_stat_mode "$src" 2>/dev/null || true)"
  [[ -n "$mode" ]] && chmod "$mode" "$dst" 2>/dev/null
}

cockpit_realpath() {
  local path=$1
  if [[ -z "$path" ]]; then
    return 1
  fi
  if [[ "$_cockpit_has_realpath" == 1 ]]; then
    realpath "$path" 2>/dev/null && return 0
  fi
  if [[ -d "$path" ]]; then
    (cd -P -- "$path" && pwd -P)
    return 0
  fi
  local dir name link target
  dir="$(dirname -- "$path")"
  name="$(basename -- "$path")"
  dir="$(cd -P -- "$dir" && pwd -P)"
  link="$dir/$name"
  if [[ -L "$link" ]]; then
    target="$(readlink "$link" 2>/dev/null || true)"
    case "$target" in
      /*) cockpit_realpath "$target" ;;
      '') printf '%s\n' "$link" ;;
      *) cockpit_realpath "$dir/$target" ;;
    esac
    return 0
  fi
  printf '%s/%s\n' "$dir" "$name"
}

cockpit_pid_alive() {
  local pid=$1
  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  _cockpit_kill_rc=$?
  if [[ "$_cockpit_kill_rc" -eq 1 ]]; then
    return 1
  fi
  return 0
}

cockpit_pid_comm() {
  local pid=$1
  ps -o comm= -p "$pid" 2>/dev/null | tr -d '\n'
}

cockpit_pid_ppid() {
  local pid=$1
  ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' '
}

cockpit_pid_environ() {
  local pid=$1 with_env cmd_only
  if [[ -r "/proc/$pid/environ" ]]; then
    tr '\0' '\n' <"/proc/$pid/environ"
    return 0
  fi
  # BSD ps -E appends the environment to the command line (same-user only).
  # Strip the plain command prefix and split KEY=value tokens onto lines.
  if [[ "$(id -u)" == "$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')" ]]; then
    with_env="$(ps -wwE -o command= -p "$pid" 2>/dev/null)" || with_env=''
    cmd_only="$(ps -ww -o command= -p "$pid" 2>/dev/null)" || cmd_only=''
    if [[ -n "$with_env" && -n "$cmd_only" && "$with_env" == "$cmd_only "* ]]; then
      printf '%s\n' "${with_env#"$cmd_only "}" | awk '
        {
          n = split($0, t, " "); line = ""
          for (i = 1; i <= n; i++) {
            if (t[i] ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { if (line != "") print line; line = t[i] }
            else if (line != "") line = line " " t[i]
          }
          if (line != "") print line
        }'
      return 0
    fi
  fi
  return 2
}

cockpit_timeout() {
  local secs=$1 cmd_pid watchdog_pid rc=0
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return $?
  fi
  # Bash watchdog (stock macOS has neither timeout nor gtimeout). Keep the
  # caller's stdin for the command; detach the watchdog from stdout/stderr so
  # a caller's $(...) never waits on the sleeper; stay errexit-safe.
  "$@" <&0 &
  cmd_pid=$!
  (
    trap 'kill "${sleeper:-}" 2>/dev/null; exit 0' TERM
    sleep "$secs" &
    sleeper=$!
    wait "$sleeper" && kill -TERM "$cmd_pid" 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  watchdog_pid=$!
  wait "$cmd_pid" 2>/dev/null || rc=$?
  kill -TERM "$watchdog_pid" 2>/dev/null || :
  wait "$watchdog_pid" 2>/dev/null || :
  if [[ "$rc" == 143 || "$rc" == 137 ]]; then
    return 124
  fi
  return "$rc"
}

# ISO-8601 UTC timestamp -> epoch seconds. GNU `date -d`, else BSD
# `date -j -f`, else python3. rc 1 when unparseable.
cockpit_utc_epoch() {
  local value=${1:-} out='' base='' offset='' sign='' oh='' om=''
  [[ -n "$value" ]] || return 1
  if [[ "$_cockpit_date_gnu" == 1 ]]; then
    out="$(date -u -d "$value" +%s 2>/dev/null)" || out=''
  else
    base=${value%%[.Zz+]*}
    case "$value" in
      *[Zz]) offset='+0000' ;;
      *[+-][0-9][0-9]:[0-9][0-9]) offset=${value: -6}; offset="${offset%%:*}${offset##*:}" ;;
      *[+-][0-9][0-9][0-9][0-9]) offset=${value: -5} ;;
    esac
    if [[ "$base" == *T*-* ]]; then
      base=${base%-[0-9][0-9]:[0-9][0-9]}
      base=${base%-[0-9][0-9][0-9][0-9]}
    fi
    if [[ -n "$offset" && "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
      out="$(date -j -u -f '%Y-%m-%dT%H:%M:%S' "$base" +%s 2>/dev/null)" || out=''
      if [[ "$out" =~ ^[0-9]+$ ]]; then
        sign=${offset:0:1}
        oh=${offset:1:2}
        om=${offset:3:2}
        if [[ "$sign" == + ]]; then
          out=$((out - (10#$oh * 3600 + 10#$om * 60)))
        else
          out=$((out + (10#$oh * 3600 + 10#$om * 60)))
        fi
      fi
    fi
  fi
  if [[ ! "$out" =~ ^[0-9]+$ ]] && command -v python3 >/dev/null 2>&1; then
    out="$(python3 -c 'import datetime,sys
v=sys.argv[1].replace("Z","+00:00").replace("z","+00:00")
d=datetime.datetime.fromisoformat(v)
if d.tzinfo is None: d=d.replace(tzinfo=datetime.timezone.utc)
print(int(d.timestamp()))' "$value" 2>/dev/null)" || out=''
  fi
  [[ "$out" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$out"
}

# Command string for `bash -lc`. On hosts whose login profile runs macOS
# path_helper (it moves system dirs ahead of the caller's PATH), re-assert the
# caller's PATH precedence so login-shell probes resolve the same binaries the
# caller sees. Other hosts get the command unchanged.
cockpit_login_command() {
  if [[ "$_cockpit_has_path_helper" == 1 ]]; then
    printf 'PATH=%q:"$PATH"; export PATH; %s\n' "$PATH" "$1"
  else
    printf '%s\n' "$1"
  fi
}

cockpit_sha256() {
  local file=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" 2>/dev/null | awk '{print $1}'
    return 0
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" 2>/dev/null | awk '{print $1}'
    return 0
  fi
  openssl dgst -sha256 -r "$file" 2>/dev/null | awk '{print $1}'
}

cockpit_sort_version() {
  if sort -V </dev/null >/dev/null 2>&1; then
    sort -V "$@"
  else
    sort "$@"
  fi
}

cockpit_pgrep_child_match() {
  local ppid=$1 pattern=$2
  local pid comm
  for pid in $(pgrep -P "$ppid" 2>/dev/null); do
    comm="$(cockpit_pid_comm "$pid")"
    if printf '%s\n' "$comm" | grep -Eq "$pattern"; then
      return 0
    fi
  done
  return 1
}

# systemd is named only inside the cockpit_service_install_systemd* helpers
# (portability-lint contract). sd_booted(3): /run/systemd/system exists.
cockpit_service_install_systemd_available() { command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; }

cockpit_has_systemd() {
  cockpit_service_install_systemd_available
}

cockpit_has_launchd() {
  command -v launchctl >/dev/null 2>&1
}

# Linux system service = the single Hostinger deploy entry (C2 dedupe); never
# a second copy of its account/unit/nginx steps here.
cockpit_service_install_systemd() {
  local root=$1 entry="$1/scripts/install-hostinger.sh"
  [[ -f "$entry" ]] || { printf 'systemd: %s missing\n' "$entry" >&2; return 1; }
  if [[ "$(id -u)" -ne 0 ]]; then
    printf 'systemd: system service needs root: sudo %s\n' "$entry" >&2
    return 2
  fi
  bash "$entry"
}

# Plist values are data: escape XML metacharacters so a path containing
# & < > is written literally instead of breaking (or injecting into) the plist.
cockpit_xml_escape() {
  local s=$1
  # Quoted replacements: bash 5.2 patsub_replacement would expand a bare &.
  s=${s//&/"&amp;"}
  s=${s//</"&lt;"}
  s=${s//>/"&gt;"}
  printf '%s' "$s"
}

cockpit_service_install_launchd() {
  local bindir=$1
  local install_root=${2:-}
  local web="$bindir/cockpit-web"
  [[ -x "$web" ]] || return 1
  local uid plist domain logdir path_prefix node_bin
  uid="$(id -u)"
  logdir="${HOME}/Library/Logs"
  path_prefix="/opt/homebrew/bin:/usr/local/bin"
  node_bin="$(command -v node 2>/dev/null || true)"
  if [[ -n "$node_bin" ]]; then
    path_prefix="$(dirname "$node_bin"):$path_prefix"
  fi
  local port_entry=""
  if [[ -n "${COCKPIT_WEB_PORT:-}" ]]; then
    if [[ "$COCKPIT_WEB_PORT" =~ ^[0-9]{1,5}$ ]]; then
      port_entry="$(printf '    <key>COCKPIT_WEB_PORT</key>\n    <string>%s</string>' "$COCKPIT_WEB_PORT")"
    else
      printf 'launchd: ignoring non-numeric COCKPIT_WEB_PORT\n' >&2
    fi
  fi
  local x_web x_log x_path x_root
  x_web="$(cockpit_xml_escape "$web")"
  x_log="$(cockpit_xml_escape "${logdir}/cockpit-web.log")"
  x_path="$(cockpit_xml_escape "${path_prefix}:${HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin")"
  x_root="$(cockpit_xml_escape "$install_root")"
  mkdir -p "${HOME}/Library/LaunchAgents" "$logdir"
  plist="${HOME}/Library/LaunchAgents/com.dezocode.cockpit-web.plist"
  launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
  launchctl bootout "user/$uid" "$plist" 2>/dev/null || true
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dezocode.cockpit-web</string>
  <key>ProgramArguments</key>
  <array>
    <string>$x_web</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
$( [[ -n "$install_root" ]] && printf '  <key>WorkingDirectory</key>\n  <string>%s</string>\n' "$x_root" )
  <key>StandardOutPath</key>
  <string>${x_log}</string>
  <key>StandardErrorPath</key>
  <string>${x_log}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>${x_path}</string>
    <key>COCKPIT_WEB_HOST</key>
    <string>127.0.0.1</string>
    <key>COCKPIT_HOSTINGER</key>
    <string>1</string>
$( [[ -n "$install_root" ]] && printf '    <key>COCKPIT_INSTALL_ROOT</key>\n    <string>%s</string>\n' "$x_root" )
${port_entry}
  </dict>
</dict>
</plist>
EOF
  if launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null; then
    domain="gui/$uid"
  elif launchctl bootstrap "user/$uid" "$plist" 2>/dev/null; then
    domain="user/$uid"
  else
    printf 'launchd: bootstrap failed for %s\n' "$plist" >&2
    return 1
  fi
  printf 'launchd: loaded %s in %s\n' "$plist" "$domain"
}

cockpit_service_install() {
  local name=${1:-cockpit-web}
  local bindir=${2:-${HOME}/.local/bin}
  local root=${3:-}
  if cockpit_has_launchd; then
    cockpit_service_install_launchd "$bindir" "$root"
    return $?
  fi
  if cockpit_has_systemd && [[ -n "$root" ]]; then
    cockpit_service_install_systemd "$root"
    return $?
  fi
  printf 'Run manually: %s/cockpit-web\n' "$bindir"
}

cockpit_rc_block_content() {
  local bindir=$1
  cat <<EOF
export PATH="$bindir:\$PATH"
unalias cockpit 2>/dev/null || true
cpr() {
  command -v cockpit >/dev/null 2>&1 || return 0
  cockpit cpr "\$@"
}
EOF
}

cockpit_rc_migrate_legacy() {
  local file=$1
  [[ -f "$file" ]] || return 0
  local tmp="${file}.cockpit-migrate.$$"
  awk '
    /^# Cockpit PATH$/ { skip=1; next }
    /^# Cockpit cpr plugin$/ { skip=1; next }
    skip && /^[[:space:]]*$/ { skip=0; next }
    skip && /^export PATH=/ { next }
    skip && /^if command -v cockpit/ { skip=2; next }
    skip && /^[[:space:]]*alias cockpit=/ { next }
    skip && /^unalias cockpit/ { next }
    skip && /^cpr\(\)/ { skip=1; next }
    skip && /^[[:space:]]*cockpit cpr/ { next }
    skip && /^}/ { skip=0; next }
    { print }
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

cockpit_rc_write_marked() {
  local file=$1 bindir=$2
  local start='# >>> cockpit >>>'
  local end='# <<< cockpit <<<'
  local block_file tmp="${file}.cockpit.$$"
  block_file="$(mktemp "${TMPDIR:-/tmp}/cockpit-rc.XXXXXX")"
  cockpit_rc_block_content "$bindir" >"$block_file"
  cockpit_rc_migrate_legacy "$file"
  mkdir -p "$(dirname -- "$file")"
  if [[ ! -f "$file" ]]; then
    : >"$file"
  fi
  if grep -Fq "$start" "$file" 2>/dev/null; then
    awk -v start="$start" -v end="$end" -v blockfile="$block_file" '
      BEGIN { inblock=0 }
      $0 == start {
        print
        while ((getline line < blockfile) > 0) print line
        close(blockfile)
        inblock=1
        next
      }
      inblock && $0 == end { print; inblock=0; next }
      inblock { next }
      { print }
    ' "$file" >"$tmp" && mv "$tmp" "$file"
  else
    {
      printf '\n%s\n' "$start"
      cat "$block_file"
      printf '%s\n' "$end"
    } >>"$file"
  fi
  rm -f "$block_file"
}

cockpit_rc_write() {
  local bindir=${1:-${HOME}/.local/bin}
  if [[ -n "${COCKPIT_SHELL_RC:-}" ]]; then
    cockpit_rc_write_marked "$COCKPIT_SHELL_RC" "$bindir"
    return 0
  fi
  local shell_name
  shell_name="$(basename "${SHELL:-bash}")"
  case "$shell_name" in
    bash)
      cockpit_rc_write_marked "${HOME}/.bashrc" "$bindir"
      if [[ -f "${HOME}/.bash_profile" ]] || [[ ! -f "${HOME}/.bashrc" ]]; then
        if [[ -f "${HOME}/.bash_profile" ]] &&
          ! grep -Fq 'source ~/.bashrc' "${HOME}/.bash_profile" 2>/dev/null &&
          ! grep -Fq '. ~/.bashrc' "${HOME}/.bash_profile" 2>/dev/null; then
          printf '\n# Cockpit: login shell loads %s/.bashrc\n[[ -f %s/.bashrc ]] && . %s/.bashrc\n' \
            "$HOME" "$HOME" "$HOME" >>"${HOME}/.bash_profile"
        fi
      fi
      ;;
    zsh)
      local zshrc="${ZDOTDIR:-$HOME}/.zshrc"
      cockpit_rc_write_marked "$zshrc" "$bindir"
      ;;
    fish)
      local fish_drop="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/cockpit.fish"
      mkdir -p "$(dirname -- "$fish_drop")"
      cat >"$fish_drop" <<EOF
fish_add_path -g $bindir
function cpr
  if command -q cockpit
    cockpit cpr \$argv
  end
end
EOF
      ;;
    *)
      cockpit_rc_write_marked "${HOME}/.bashrc" "$bindir"
      ;;
  esac
}

cockpit_inotifywatch_stream() {
  local path=$1
  shift
  inotifywait -m -q "$@" --format '%w%f' "$path" 1>&"$COCKPIT_EVENT_FD" 2>/dev/null &
  COCKPIT_INOTIFY_PIDS+=($!)
}

