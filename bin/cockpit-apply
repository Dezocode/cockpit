#!/usr/bin/env bash
# Push cockpit config into a live tmux server without touching the Agent PTY.
# Validates the overlay on a throwaway server first.
set -euo pipefail

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=cockpit-lib
source "$script_root/cockpit-lib"

export PATH="$HOME/.local/bin:$PATH"
session="${1:-$(cockpit_session_name)}"
overlay="$(cockpit_overlay_path)"
label="cockpit-validate-$$"

# New installs use the Cockpit-native CPR plugin. Keeping this handoff here
# makes `install.sh` and older automation inherit the same no-respawn safety
# contract as the `cpr` shell command.
if [[ "${COCKPIT_APPLY_LEGACY:-0}" != 1 ]] &&
  command -v cockpit-plugin >/dev/null 2>&1; then
  exec cockpit-plugin cpr --session "$session" --apply
fi

if [[ ! -f "$overlay" ]]; then
  printf 'cockpit apply: missing %s\n' "$overlay" >&2
  exit 1
fi

tmux -L "$label" kill-server >/dev/null 2>&1 || true
if ! tmux -L "$label" -f /dev/null new-session -d -s v -n t 'sleep 5' >/dev/null 2>&1; then
  printf 'cockpit apply: could not start isolated tmux\n' >&2
  exit 1
fi
if ! tmux -L "$label" source-file "$overlay" >/dev/null 2>&1; then
  tmux -L "$label" kill-server >/dev/null 2>&1 || true
  printf 'cockpit apply: overlay failed isolated check; live server left alone\n' >&2
  exit 1
fi
tmux -L "$label" kill-server >/dev/null 2>&1 || true

tmux has-session -t "$session" 2>/dev/null || exit 0
tmux source-file "$overlay" 2>/dev/null || true
cockpit-hooks-install >/dev/null 2>&1 || true
cockpit-probe-install >/dev/null 2>&1 || true

tmux set-option -t "$session" status-interval 0
if [[ "$(tmux show-options -v -t "$session" @cockpit_modality 2>/dev/null || true)" == "touch" ]]; then
  tmux set-option -t "$session" escape-time 120
else
  tmux set-option -t "$session" escape-time 10
fi
tmux set-option -s exit-empty off 2>/dev/null || true

runtime="$(
  tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
    awk '$2 == "runtime" { print $1; exit }'
)"
if [[ -n "$runtime" ]]; then
  tmux set-option -t "$session" @cockpit_runtime_pane "$runtime"
  tmux set-option -p -t "$runtime" remain-on-exit on 2>/dev/null || true
fi

# Never respawn any pane. Unstick any idle probe table.
while IFS= read -r c; do
  [[ -n "$c" ]] || continue
  tmux switch-client -c "$c" -T root 2>/dev/null || true
done < <(tmux list-clients -t "$session" -F '#{client_name}' 2>/dev/null || true)
cockpit-agent-hook "$session" >/dev/null 2>&1 || true
