#!/usr/bin/env bash
# Legacy compatibility entrypoint; canonical implementation is under the cockpit namespace.
set -euo pipefail
legacy_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
legacy_name="${BASH_SOURCE[0]##*/}"
case "$legacy_name" in
  codex-cockpit) canonical_name=cockpit-main ;;
  codex-mermaid-watch) canonical_name=cockpit-mermaid-watch ;;
  codex-cockpit-*) canonical_name="cockpit-${legacy_name#codex-cockpit-}" ;;
  *) printf "unknown legacy entrypoint: %s\n" "$legacy_name" >&2; exit 2 ;;
esac
exec "$legacy_root/$canonical_name" "$@"
