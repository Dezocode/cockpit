#!/usr/bin/env bash
set -euo pipefail

blue=$'\033[38;5;4m'
muted=$'\033[38;5;8m'
bright=$'\033[1;37m'
reset=$'\033[0m'

profile=foot
if [[ -n "${TMUX:-}" ]]; then
  profile="$(tmux show-options -v @cockpit_profile 2>/dev/null || true)"
fi
[[ -n "$profile" ]] || profile="$(codex-cockpit-profile $$ 2>/dev/null || echo foot)"

if [[ "$profile" == "termius-ios" ]]; then
  map_title="Termius iOS  ·  touch"
  map_body=$(cat <<EOF
${bright}TOUCH${reset}  (this client: iPhone SSH / Tailscale)
  ${blue}Tap a tab${reset}                     CODEX  FILES  DIFF  MAP  PRS
  ${blue}Tap AUTH / runtime / MODEL${reset}    fat buttons above the agent
  ${blue}Long-press${reset}                    Cockpit menu
  ${blue}Double-tap runtime${reset}            AGENT fullscreen (same PTY)
  ${blue}F1${reset} Runtime   ${blue}F2${reset} Files   ${blue}F3${reset} Diff   ${blue}F4${reset} Map   ${blue}F5${reset} PRs   ${blue}F6${reset} Help
  Nested flows (auth, runtime pick) open as a tab — Termius cannot
  show overlay popups. ${blue}q / Esc / tap CODEX${reset} closes and returns.
  Enable Termius ${blue}Send mouse events${reset}.

${bright}KEYS${reset}  prefix = ${blue}CTRL + B${reset}  (CTRL + A also)
  ${blue}prefix + H${reset}                   This help
  ${blue}prefix + a / z${reset}               Runtime / zoom
  ${blue}ALT + 1..5${reset}                  Jump to a tab
EOF
)
else
  map_title="Foot  ·  Omarchy"
  map_body=$(cat <<EOF
${bright}FOOT / OMARCHY${reset}
  ${blue}SUPER + RETURN${reset}               Foot terminal
  ${blue}SUPER + ALT + C${reset}              Open this cockpit in Foot
  ${blue}SUPER + ALT + K${reset}              Omarchy tmux key list
  ${blue}SUPER + ALT + SHIFT + C${reset}      This help as a Foot TUI

${bright}KEYS${reset}  prefix = ${blue}CTRL + SPACE${reset}  (CTRL + B also)
  ${blue}prefix + H${reset}                   This help
  ${blue}prefix + a${reset}                   Focus runtime (AGENT zoom)
  ${blue}prefix + f / D / d / g${reset}       Files / Diff / Map / PRs
  ${blue}prefix + z${reset}                   Zoom / unzoom
  ${blue}CTRL + ALT + ARROWS${reset}         Move between panes
  ${blue}ALT + ENTER${reset}                 Split (Omarchy Foot CSI-u)
  Double-click the runtime pane for AGENT zoom.
EOF
)
fi

cat <<EOF | less -R
${blue}╭──────────────────────────────────────────────────────────────╮${reset}
${blue}│${reset} ${bright}CODEX COCKPIT${reset}  ·  ${map_title}${blue}│${reset}
${blue}╰──────────────────────────────────────────────────────────────╯${reset}

${bright}START${reset}
  ${blue}codex${reset}                         Open this project's cockpit
  ${blue}codex-cli${reset}                     Underlying Codex CLI without tmux
  ${blue}omarchy launch tui codex-cockpit${reset}
                                Foot, Omarchy-styled

Launch shows a keyboard-only desktop | touch screen. After it idles, the
next key is desktop and the next tap is touch. While attached, idle again
and the same switch runs without stealing keys from Codex until then.

${blue}prefix + k${reset} desktop/keyboard    ${blue}prefix + t${reset} touch/mobile
${blue}prefix + A${reset} auth popup (providers.conf)    ${blue}prefix + G${reset} GitHub OAuth box
${blue}prefix + e${reset} / ${blue}F7${reset} / tap CODEX button  provider list, then nested:
     ${blue}s${reset} switch active (pause the other)  ·  ${blue}p${reset} parallel tab
     Desktop: click outside the box to cancel.
     Termius: q / Esc / tap CODEX returns to the agent. OAuth stays with each CLI.

PRs open a nested login box only when GitHub is unsigned. Click outside
that box to skip. It closes itself after a successful gh CLI OAuth.
Codex CLI and Grok OAuth are unchanged and not wired through this list.

Endpoint size still applies: a phone-sized client stays on tabs. A desktop
client uses the 2x2 pad for keyboard and tabs for touch.

${map_body}

${bright}PANES${reset}
  ${blue}CODEX${reset}   Live runtime, approvals, applied edits
  ${blue}FILES${reset}   Neovim; follows Codex writes when this view is on screen
  ${blue}DIFF${reset}    Project patch; idle until edits
  ${blue}MAP${reset}     Mermaid; redraws when the diagram changes
  ${blue}PRS${reset}     GitHub PRs

${muted}Press q to close.${reset}
EOF
