#!/usr/bin/env bash
# Termius-safe tap dispatcher. run-shell PATH is often empty on iOS SSH, and
# #{mouse_pane} / #{mouse_session} are unreliable — never require them.
# Arguments must stay quoted: an empty #{mouse_x} otherwise shifts the pane
# id into the y slot and the tap lands on the wrong chip, or none.
set -euo pipefail
export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH}"

kind="${1:-}"
shift || true

now_ms() {
  local n
  n="$(date +%s%3N 2>/dev/null || true)"
  if [[ "$n" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$n"
  else
    printf '%s000\n' "$(date +%s)"
  fi
}

# One tap = one action. Press+release and tiny drags must not fire twice,
# and Agent-pane taps must not also fire MODEL/PRS.
DEBOUNCE_MS=280
debounce() {
  local key=$1 dir now last last_ms
  dir="${XDG_RUNTIME_DIR:-/tmp}/codex-cockpit"
  mkdir -p "$dir"
  now="$(now_ms)"
  last="$(cat "$dir/pointer.stamp" 2>/dev/null || true)"
  last_ms="${last##* }"
  if [[ "$last_ms" =~ ^[0-9]+$ ]] && ((now >= last_ms && now - last_ms < DEBOUNCE_MS)); then
    return 1
  fi
  printf '%s %s\n' "$key" "$now" >"$dir/pointer.stamp"
  return 0
}

session_of() {
  local s=${1:-}
  if [[ -n "$s" && "$s" == codex-cockpit* ]]; then
    printf '%s\n' "$s"
    return 0
  fi
  tmux display-message -p '#{client_session}' 2>/dev/null || tmux display-message -p '#{session_name}' 2>/dev/null || printf 'codex-cockpit\n'
}

role_of() {
  local pane=$1
  [[ -n "$pane" ]] || { printf '\n'; return 0; }
  tmux display-message -p -t "$pane" '#{@cockpit_role}' 2>/dev/null || true
}

window_of() {
  local target=$1
  [[ -n "$target" ]] || { printf '\n'; return 0; }
  tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true
}

is_pane_id() {
  [[ "${1:-}" == %* ]]
}

trim() {
  local value=${1:-}
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

bar_click() {
  local x=$1 pane=$2 session=$3 chip
  # No column → wait for the other half of the tap instead of firing PRS.
  [[ "$x" =~ ^[0-9]+$ ]] || return 0
  [[ -n "$pane" ]] || return 0
  chip="$(codex-cockpit-bar which "$x" "$pane" "$session" 2>/dev/null || printf '%s' "$x")"
  debounce "bar $session $chip" || return 0
  exec codex-cockpit-bar click "$x" "$pane" "$session"
}

case "$kind" in
  pane)
    x="$(trim "${1:-}")"
    y="$(trim "${2:-}")"
    pane="$(trim "${3:-}")"
    session="$(session_of "$(trim "${4:-}")")"
    win="$(trim "${5:-}")"
    [[ "$x" =~ ^[0-9]+$ ]] || x=""
    [[ "$y" =~ ^[0-9]+$ ]] || y=""
    if ! is_pane_id "$pane"; then
      pane=""
    fi

    bar="$(tmux show-options -v -t "$session" @cockpit_bar_pane 2>/dev/null || true)"
    runtime="$(tmux show-options -v -t "$session" @cockpit_runtime_pane 2>/dev/null || true)"
    profile="$(tmux show-options -v -t "$session" @cockpit_profile 2>/dev/null || true)"

    if [[ -z "$pane" ]]; then
      # Missing pane id: only treat as chips when Y is explicitly in the
      # toolbar. Empty Y used to steal Agent taps and fire MODEL/PRS.
      if [[ -n "$bar" && "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
        bar_h="$(tmux display-message -p -t "$bar" '#{pane_height}' 2>/dev/null || echo 2)"
        [[ "$bar_h" =~ ^[0-9]+$ ]] || bar_h=2
        if ((y < bar_h)); then
          pane="$bar"
        fi
      fi
      if [[ -z "$pane" && -n "$runtime" ]]; then
        pane="$runtime"
      fi
    fi

    role="$(role_of "$pane")"
    if [[ "$role" == "bar" || ( -n "$bar" && "$pane" == "$bar" ) ]]; then
      bar_click "$x" "${pane:-$bar}" "$session"
      exit 0
    fi
    if [[ "$role" == "runtime" || "$role" == "parallel" ]]; then
      debounce "pane $session $pane" || exit 0
      tmux select-pane -t "$pane" 2>/dev/null || true
      # Termius: do not inject mouse into Codex. It BEL-rings the phone.
      if [[ "$profile" != "termius-ios" ]]; then
        tmux send-keys -t "$pane" -M 2>/dev/null || true
      fi
      exit 0
    fi
    if [[ -n "$pane" ]]; then
      debounce "pane $session $pane" || exit 0
      tmux select-pane -t "$pane" 2>/dev/null || true
    else
      tmux select-pane -t = 2>/dev/null || true
    fi
    ;;
  status)
    session="$(session_of "$(trim "${1:-}")")"
    range="$(trim "${2:-}")"
    win="$(trim "${3:-}")"
    debounce "status $session $range $win" || exit 0
    case "$range" in
      user\|prs|prs) exec codex-cockpit-touch "$session" prs ;;
      user\|runtime|runtime|user\|agent|agent) exec codex-cockpit-touch "$session" agent ;;
      user\|model|model) exec codex-cockpit-touch "$session" setup model ;;
      user\|restart|restart) exec codex-cockpit-restart "$session" ;;
      user\|setup|setup|left) exec codex-cockpit-touch "$session" setup ;;
    esac
    export PATH="${HOME}/.local/bin:$PATH"
    if [[ -f "${HOME}/.local/bin/codex-cockpit-auth-lib" ]]; then
      # shellcheck source=/dev/null
      source "${HOME}/.local/bin/codex-cockpit-auth-lib" 2>/dev/null || true
      if command -v cockpit_popup_any >/dev/null 2>&1 && cockpit_popup_any; then
        cockpit_popup_dismiss "$session" || true
        exit 0
      fi
    fi
    if [[ -n "$win" ]]; then
      tmux select-window -t "$win" 2>/dev/null || tmux select-window -t = 2>/dev/null || true
    else
      tmux select-window -t = 2>/dev/null || true
    fi
    ;;
  status-left)
    session="$(session_of "$(trim "${1:-}")")"
    debounce "left $session" || exit 0
    exec codex-cockpit-touch "$session" setup
    ;;
  *)
    exit 0
    ;;
esac
