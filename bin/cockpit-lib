# shellcheck shell=bash disable=SC2034,SC2154
# Shared event policy for cockpit watchers. Sourced, not executed.
# Idle: block on inotify. Hidden tabs keep a dirty bit. Visible tabs
# coalesce bursts, skip noise, and skip redraws when the fingerprint is unchanged.

_lib_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=cockpit-portable-lib
source "$_lib_root/cockpit-portable-lib"
cockpit_require_bash4 "$@" || return 64

: "${COCKPIT_DEBOUNCE:=0.40}"
: "${XDG_RUNTIME_DIR:=/tmp}"

cockpit_noise_exclude='(^|/)(\.git|node_modules|\.cache|dist|build|target|\.local|\.npm)(/|$)|(\.swp|\.swo|\.swn|~$|\.tmp$|\.sock$)'

# Cockpit is the canonical public namespace. The old codex-cockpit locations
# remain readable so an existing installation can be upgraded in place.
cockpit_config_home() {
  if [[ -n "${COCKPIT_CONFIG_HOME:-}" ]]; then
    printf '%s\n' "$COCKPIT_CONFIG_HOME"
  elif [[ -n "${COCKPIT_AUTH_HOME:-}" ]]; then
    printf '%s\n' "$COCKPIT_AUTH_HOME"
  else
    printf '%s/cockpit\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
  fi
}

cockpit_legacy_config_home() {
  printf '%s\n' "${COCKPIT_LEGACY_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/codex-cockpit}"
}

cockpit_config_read_path() {
  local relative=$1 canonical legacy
  canonical="$(cockpit_config_home)/$relative"
  legacy="$(cockpit_legacy_config_home)/$relative"
  if [[ -e "$canonical" || ! -e "$legacy" ]]; then
    printf '%s\n' "$canonical"
  else
    printf '%s\n' "$legacy"
  fi
}

cockpit_overlay_path() {
  local canonical legacy
  if [[ -n "${COCKPIT_OVERLAY_FILE:-}" ]]; then
    printf '%s\n' "$COCKPIT_OVERLAY_FILE"
    return 0
  fi
  canonical="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/cockpit.conf"
  legacy="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/codex-cockpit.conf"
  if [[ -f "$canonical" || ! -f "$legacy" ]]; then
    printf '%s\n' "$canonical"
  else
    printf '%s\n' "$legacy"
  fi
}

cockpit_session_name() {
  printf '%s\n' "${COCKPIT_SESSION:-${CODEX_COCKPIT_SESSION:-cockpit}}"
}

cockpit_session_is_managed() {
  local session=${1:-}
  [[ "$session" == cockpit || "$session" == cockpit-* ||
    "$session" == codex-cockpit || "$session" == codex-cockpit-* ]]
}

cockpit_migrate_legacy_session() {
  local target=${1:-$(cockpit_session_name)}
  local legacy=${COCKPIT_LEGACY_SESSION:-codex-cockpit}
  [[ "$target" == cockpit && "$legacy" != "$target" ]] || return 1
  tmux has-session -t "$target" 2>/dev/null && return 1
  tmux has-session -t "$legacy" 2>/dev/null || return 1
  tmux rename-session -t "$legacy" "$target" 2>/dev/null
}

cockpit_runtime_home() {
  printf '%s/cockpit\n' "$XDG_RUNTIME_DIR"
}

cockpit_legacy_runtime_home() {
  printf '%s/codex-cockpit\n' "$XDG_RUNTIME_DIR"
}

declare -gA COCKPIT_THEME_HEX_CACHE=()

cockpit_shell_quote() {
  local value=${1:-}
  value=${value//\\/\\\\}
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

# --- Shared tmux / shell helpers (deduped from cockpit-* scripts) ---

cockpit_tmux_fg() {
  local key=$1 fallback=$2
  printf '#[fg=%s]' "$(cockpit_theme_hex "$key" "$fallback")"
}

cockpit_window_of() {
  local target=$1
  [[ -n "$target" ]] || { printf '\n'; return 0; }
  tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true
}

cockpit_pane_for() {
  local session=$1 role=$2
  case "${3:-simple}" in
    reload)
      case "$role" in
        runtime)
          tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role} #{window_name}' 2>/dev/null |
            awk '$2 == "runtime" || ($2 == "" && ($3 == "AGENT" || $3 == "CODEX")) { print $1; exit }'
          return 0
          ;;
      esac
      local window
      case "$role" in
        diff) window=DIFF ;;
        map) window=MAP ;;
        *) window="${role^^}" ;;
      esac
      tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role} #{window_name}' 2>/dev/null |
        awk -v r="$role" -v w="$window" '$2 == r || ($2 == "" && $3 == w) { print $1; exit }'
      ;;
    *)
      tmux list-panes -s -t "$session" -F '#{pane_id} #{@cockpit_role}' 2>/dev/null |
        awk -v r="$role" '$2 == r { print $1; exit }'
      ;;
  esac
}

cockpit_update_git_chrome() {
  local session=$1 mode=${2:-adapt}
  shift 2 || true
  local status=${1:-} git_root=${2:-} project_root=${3:-}
  local runtime root worktree branch state state_style label
  case "$mode" in
    diff)
      if [[ -n "$git_root" ]]; then
        worktree="${git_root##*/}"
        branch="$(git -C "$git_root" symbolic-ref --short -q HEAD 2>/dev/null ||
          git -C "$git_root" rev-parse --short HEAD 2>/dev/null || true)"
        [[ -n "$branch" ]] || branch=detached
        if [[ -n "$status" ]]; then
          state='!'
          state_style="$(cockpit_tmux_fg diff_change "$(cockpit_theme_hex accent '#798186')")"
        else
          state='✓'
          state_style="$(cockpit_tmux_fg diff_add "$(cockpit_theme_hex green '#2b6e4f')")"
        fi
        label="$(cockpit_tmux_fg accent '#798186')${worktree}$(cockpit_tmux_fg muted '#4b4e55') ${branch} ${state_style}${state}#[default]"
      else
        worktree="${project_root##*/}"
        label="$(cockpit_tmux_fg muted '#4b4e55')${worktree} ?#[default]"
      fi
      ;;
    *)
      runtime="$(cockpit_pane_for "$session" runtime)"
      [[ -n "$runtime" ]] || return 0
      root="$(tmux display-message -p -t "$runtime" '#{pane_current_path}' 2>/dev/null || true)"
      [[ -n "$root" ]] || return 0
      git_root="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ -n "$git_root" ]]; then
        worktree="${git_root##*/}"
        branch="$(git -C "$git_root" symbolic-ref --short -q HEAD 2>/dev/null ||
          git -C "$git_root" rev-parse --short HEAD 2>/dev/null || true)"
        [[ -n "$branch" ]] || branch=detached
        status="$(git -C "$git_root" status --porcelain --untracked-files=normal 2>/dev/null || true)"
        if [[ -n "$status" ]]; then
          state='!'
          state_style="$(cockpit_tmux_fg accent '#798186')"
        else
          state='✓'
          state_style="$(cockpit_tmux_fg green '#2b6e4f')"
        fi
        label="$(cockpit_tmux_fg accent '#798186')${worktree}$(cockpit_tmux_fg muted '#4b4e55') ${branch} ${state_style}${state}#[default]"
      else
        worktree="${root##*/}"
        label="$(cockpit_tmux_fg muted '#4b4e55')${worktree} ?#[default]"
      fi
      ;;
  esac
  tmux set-option -t "$session" @cockpit_worktree "$worktree"
  tmux set-option -t "$session" @cockpit_git_label "$label"
}

cockpit_clear_screen() {
  printf '\033[2J\033[H'
}

cockpit_maybe_render() {
  local render_fn=$1 hidden_fn=${2:-}
  if cockpit_view_visible; then
    "$render_fn"
  elif [[ -n "$hidden_fn" ]]; then
    "$hidden_fn"
  fi
}

# --- end shared tmux / shell helpers ---

# mise's shim may try to mutate its installation on every invocation. That is
# a poor fit for a long-lived tmux pane, and it also fails on read-only or
# offline hosts even when a usable Codex binary is already installed. Keep the
# explicit override authoritative, otherwise use the newest local mise binary
# only when the PATH entry is the mutating shim.
cockpit_resolve_codex_bin() {
  local configured=${CODEX_CLI_BIN:-} candidate direct

  if [[ -n "$configured" ]]; then
    [[ -x "$configured" ]] || return 1
    printf '%s\n' "$configured"
    return 0
  fi

  candidate="$(command -v codex 2>/dev/null || true)"
  [[ -n "$candidate" ]] || return 1

  if [[ -f "$candidate" ]] && command -v rg >/dev/null 2>&1 &&
    rg -q 'mise[[:space:]]+(use|x)' "$candidate" 2>/dev/null; then
    direct="$(find "$HOME/.local/share/mise/installs/codex" \
      -mindepth 3 -maxdepth 3 -type f -path '*/bin/codex' -perm -111 \
      -print 2>/dev/null | cockpit_sort_version | tail -1 || true)"
    if [[ -n "$direct" && -x "$direct" ]]; then
      printf '%s\n' "$direct"
      return 0
    fi
  fi

  [[ -x "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

# Replace only the stock `codex` provider command. Custom provider commands
# remain untouched, while `codex --oss` still uses the resolved binary.
cockpit_codex_runtime_command() {
  local command=${1:-} codex_bin=${2:-} quoted
  [[ -n "$command" && -n "$codex_bin" ]] || return 1
  quoted="$(cockpit_shell_quote "$codex_bin")"
  case "$command" in
    codex) printf '%s\n' "$quoted" ;;
    'codex '*) printf '%s%s\n' "$quoted" "${command#codex}" ;;
    *) printf '%s\n' "$command" ;;
  esac
}

cockpit_runtime_color_setup() {
  # Preserve the terminal's negotiated TERM, but provide a sane truecolor
  # fallback for SSH clients that omit COLORTERM. Clear inherited CI/no-color
  # switches before the provider starts; they are common in Codex shell
  # snapshots and suppress the native TUI palette.
  printf '%s' 'export TERM="${TERM:-tmux-256color}" COLORTERM="${COLORTERM:-truecolor}" CLICOLOR=1 CLICOLOR_FORCE=1 FORCE_COLOR=1; unset NO_COLOR CARGO_TERM_COLOR CODEX_CI;'
}

# Resolve colors from the active Omarchy theme when one is available. The
# terminal panes use truecolor SGR sequences so the same source theme feeds
# Foot, tmux, and Termius without baking a particular theme into the app.
cockpit_theme_colors_file() {
  local path="${COCKPIT_THEME_COLORS_FILE:-${HOME}/.local/state/omarchy/current/theme/colors.toml}"
  [[ -r "$path" ]] && printf '%s\n' "$path"
}

cockpit_theme_hex() {
  local key=${1:-} fallback=${2:-} path value
  if [[ -n "$key" ]]; then
    if [[ ${COCKPIT_THEME_HEX_CACHE[$key]+present} ]]; then
      printf '%s\n' "${COCKPIT_THEME_HEX_CACHE[$key]}"
      return 0
    fi
  fi
  path="$(cockpit_theme_colors_file || true)"
  if [[ -n "$path" ]]; then
    value="$(awk -F= -v wanted="$key" '
      $1 ~ "^[[:space:]]*" wanted "[[:space:]]*$" {
        value=$2
        gsub(/[[:space:]]/, "", value)
        gsub(/"/, "", value)
        if (value ~ /^#[[:xdigit:]]{6}$/) print value
        exit
      }
    ' "$path")"
    if [[ -n "$value" ]]; then
      [[ -n "$key" ]] && COCKPIT_THEME_HEX_CACHE[$key]=$value
      printf '%s\n' "$value"
      return 0
    fi
  fi
  [[ -n "$key" ]] && COCKPIT_THEME_HEX_CACHE[$key]=$fallback
  printf '%s\n' "$fallback"
}

cockpit_theme_load_cache() {
  local path key value
  path="$(cockpit_theme_colors_file || true)"
  [[ -n "$path" ]] || return 0
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" && -n "$value" ]] || continue
    COCKPIT_THEME_HEX_CACHE[$key]=$value
  done < <(awk -F= '
    /^[[:space:]]*[[:alnum:]_]+[[:space:]]*=/ {
      key=$1
      value=$2
      gsub(/[[:space:]]/, "", key)
      gsub(/[[:space:]]/, "", value)
      gsub(/"/, "", value)
      if (value ~ /^#[[:xdigit:]]{6}$/) print key "\t" value
    }
  ' "$path")
}

cockpit_theme_load_cache

cockpit_theme_color_is_saturated() {
  local hex=${1:-}
  [[ "$hex" =~ ^#([[:xdigit:]]{2})([[:xdigit:]]{2})([[:xdigit:]]{2})$ ]] || return 1
  local r=$((16#${BASH_REMATCH[1]}))
  local g=$((16#${BASH_REMATCH[2]}))
  local b=$((16#${BASH_REMATCH[3]}))
  local max=$r min=$r
  ((g > max)) && max=$g
  ((b > max)) && max=$b
  ((g < min)) && min=$g
  ((b < min)) && min=$b
  ((max - min >= 28))
}

cockpit_theme_contrast_key() {
  local hex=${1:-}
  [[ "$hex" =~ ^#([[:xdigit:]]{2})([[:xdigit:]]{2})([[:xdigit:]]{2})$ ]] || {
    printf '%s\n' foreground
    return 0
  }
  local r=$((16#${BASH_REMATCH[1]}))
  local g=$((16#${BASH_REMATCH[2]}))
  local b=$((16#${BASH_REMATCH[3]}))
  if ((r * 299 + g * 587 + b * 114 > 255 * 580)); then
    printf '%s\n' background
  else
    printf '%s\n' foreground
  fi
}

cockpit_theme_load_diff_cache() {
  local add=${COCKPIT_DIFF_ADD_BG:-} delete=${COCKPIT_DIFF_DELETE_BG:-}
  local themed_add themed_delete themed_bright_delete

  if [[ ! "$add" =~ ^#[[:xdigit:]]{6}$ ]]; then
    themed_add="$(cockpit_theme_hex green '')"
    if cockpit_theme_color_is_saturated "$themed_add"; then
      add=$themed_add
    else
      themed_add="$(cockpit_theme_hex bright_green '')"
      if cockpit_theme_color_is_saturated "$themed_add"; then
        add=$themed_add
      else
        # Solitude intentionally makes regular green neutral. Keep its dark
        # base, but restore the semantic hue the diff needs to be readable.
        add='#2b6e4f'
      fi
    fi
  fi

  if [[ ! "$delete" =~ ^#[[:xdigit:]]{6}$ ]]; then
    themed_delete="$(cockpit_theme_hex red '')"
    themed_bright_delete="$(cockpit_theme_hex bright_red '')"
    if cockpit_theme_color_is_saturated "$themed_delete"; then
      delete=$themed_delete
    elif cockpit_theme_color_is_saturated "$themed_bright_delete"; then
      delete=$themed_bright_delete
    else
      delete='#8f3f35'
    fi
  fi

  COCKPIT_THEME_HEX_CACHE[diff_add]=$add
  COCKPIT_THEME_HEX_CACHE[diff_delete]=$delete
  COCKPIT_THEME_DIFF_ADD_FG="$(cockpit_theme_contrast_key "$add")"
  COCKPIT_THEME_DIFF_DELETE_FG="$(cockpit_theme_contrast_key "$delete")"
}

cockpit_theme_load_diff_cache

cockpit_theme_style() {
  local fg_key=${1:-} bg_key=${2:-} bold=${3:-0}
  local fg_hex bg_hex seq='' r g b

  if [[ "$bold" == "1" ]]; then
    seq='1'
  fi

  fg_hex="$(cockpit_theme_hex "$fg_key" '')"
  if [[ "$fg_hex" =~ ^#([[:xdigit:]]{2})([[:xdigit:]]{2})([[:xdigit:]]{2})$ ]]; then
    r=$((16#${BASH_REMATCH[1]}))
    g=$((16#${BASH_REMATCH[2]}))
    b=$((16#${BASH_REMATCH[3]}))
    [[ -n "$seq" ]] && seq+=';'
    seq+="38;2;${r};${g};${b}"
  else
    case "$fg_key" in
      accent|blue) fg_hex='34' ;;
      muted|bright_black) fg_hex='90' ;;
      red|bright_red) fg_hex='31' ;;
      green|bright_green) fg_hex='32' ;;
      yellow|bright_yellow) fg_hex='33' ;;
      foreground|bright_foreground) fg_hex='97' ;;
      background) fg_hex='30' ;;
      *) fg_hex='39' ;;
    esac
    [[ -n "$seq" ]] && seq+=';'
    seq+="$fg_hex"
  fi

  bg_hex="$(cockpit_theme_hex "$bg_key" '')"
  if [[ -n "$bg_key" && "$bg_hex" =~ ^#([[:xdigit:]]{2})([[:xdigit:]]{2})([[:xdigit:]]{2})$ ]]; then
    r=$((16#${BASH_REMATCH[1]}))
    g=$((16#${BASH_REMATCH[2]}))
    b=$((16#${BASH_REMATCH[3]}))
    [[ -n "$seq" ]] && seq+=';'
    seq+="48;2;${r};${g};${b}"
  elif [[ -n "$bg_key" ]]; then
    case "$bg_key" in
      accent|blue) bg_hex='44' ;;
      muted|bright_black) bg_hex='100' ;;
      red|bright_red) bg_hex='41' ;;
      green|bright_green) bg_hex='42' ;;
      yellow|bright_yellow) bg_hex='43' ;;
      background) bg_hex='49' ;;
      *) bg_hex='49' ;;
    esac
    [[ -n "$seq" ]] && seq+=';'
    seq+="$bg_hex"
  fi

  printf '\033[%sm' "${seq:-0}"
}

cockpit_theme_reset() {
  printf '\033[0m'
}

cockpit_theme_heading() {
  cockpit_theme_style accent '' 1
}

cockpit_theme_muted() {
  cockpit_theme_style muted '' 0
}

cockpit_theme_add() {
  cockpit_theme_style "$COCKPIT_THEME_DIFF_ADD_FG" diff_add 0
}

cockpit_theme_delete() {
  cockpit_theme_style "$COCKPIT_THEME_DIFF_DELETE_FG" diff_delete 0
}

cockpit_theme_change() {
  cockpit_theme_style background accent 0
}

cockpit_diff_colorize() {
  local line
  local add delete change heading heading_bold reset
  add="$(cockpit_theme_add)"
  delete="$(cockpit_theme_delete)"
  change="$(cockpit_theme_change)"
  heading="$(cockpit_theme_style accent '' 0)"
  heading_bold="$(cockpit_theme_style accent '' 1)"
  reset="$(cockpit_theme_reset)"

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      'diff --git '*) printf '%s%s%s\n' "$heading_bold" "$line" "$reset" ;;
      '+++'*|'---'*) printf '%s%s%s\n' "$heading" "$line" "$reset" ;;
      '@@'*) printf '%s%s%s\n' "$change" "$line" "$reset" ;;
      '+'*) printf '%s%s\033[K%s\n' "$add" "$line" "$reset" ;;
      '-'*) printf '%s%s\033[K%s\n' "$delete" "$line" "$reset" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

cockpit_diff_status_colorize() {
  local line code style reset
  local add delete change muted
  add="$(cockpit_theme_add)"
  delete="$(cockpit_theme_delete)"
  change="$(cockpit_theme_change)"
  muted="$(cockpit_theme_muted)"
  reset="$(cockpit_theme_reset)"

  while IFS= read -r line || [[ -n "$line" ]]; do
    code=${line:0:2}
    case "$code" in
      '??'|*A*) style=$add ;;
      *D*) style=$delete ;;
      *M*|*R*|*C*) style=$change ;;
      *) style=$muted ;;
    esac
    printf '%s%s\033[K%s\n' "$style" "$line" "$reset"
  done
}

cockpit_is_text_ext() {
  case "${1##*.}" in
    md|mmd|mermaid|txt|json|toml|yml|yaml|lua|py|rs|go|js|ts|tsx|jsx|css|html|sh|bash|zsh|rb|c|h|cc|cpp|hpp|java|kt|swift|nix|sql|graphql|xml|svg|csv|env|ini|conf|cfg|r|php|ex|exs|erl|hs|ml|vim)
      return 0
      ;;
  esac
  case "$1" in
    *Dockerfile*|*Makefile*|*README*|*LICENSE*|*.gitignore|*.gitmodules)
      return 0
      ;;
  esac
  return 1
}

cockpit_is_noise_path() {
  local path=$1 base=${1##*/}
  case "$path" in
    */.git/*|*/node_modules/*|*/.cache/*|*/dist/*|*/build/*|*/target/*) return 0 ;;
  esac
  case "$base" in
    *.swp|*.swo|*.swn|*~|*.tmp|*.sock|.DS_Store) return 0 ;;
  esac
  return 1
}

cockpit_view_visible() {
  local pane=${TMUX_PANE:-}
  local active zoomed pane_active
  [[ -n "$pane" ]] || return 0
  active="$(tmux display-message -p -t "$pane" '#{window_active}' 2>/dev/null || echo 0)"
  [[ "$active" == "1" ]] || return 1
  zoomed="$(tmux display-message -p -t "$pane" '#{window_zoomed_flag}' 2>/dev/null || echo 0)"
  pane_active="$(tmux display-message -p -t "$pane" '#{pane_active}' 2>/dev/null || echo 0)"
  if [[ "$zoomed" == "1" && "$pane_active" != "1" ]]; then
    return 1
  fi
  return 0
}

cockpit_wake_dir() {
  local session=${1:-${COCKPIT_SESSION:-unknown}}
  printf '%s/%s' "$(cockpit_runtime_home)" "$session"
}

cockpit_legacy_wake_dir() {
  local session=${1:-${COCKPIT_SESSION:-unknown}}
  printf '%s/%s' "$(cockpit_legacy_runtime_home)" "$session"
}

cockpit_install_wake() {
  local session=${1:-} name=${2:-}
  COCKPIT_WAKE=0
  mkdir -p "$(cockpit_wake_dir "$session")"
  printf '%s\n' "${BASHPID:-$$}" >"$(cockpit_wake_dir "$session")/${name}.pid"
  trap 'COCKPIT_WAKE=1' USR1
}

# Block on inotify + tab-open (USR1). No idle polling.
cockpit_event_open() {
  local session=$1 name=$2
  local dir fifo
  dir="$(cockpit_wake_dir "$session")"
  mkdir -p "$dir"
  fifo="$dir/${name}.$$.fifo"
  rm -f "$fifo"
  mkfifo -m 600 "$fifo"
  exec {COCKPIT_EVENT_FD}<>"$fifo"
  COCKPIT_EVENT_FIFO=$fifo
  COCKPIT_INOTIFY_PIDS=()
  COCKPIT_WAKE=0
  trap 'printf "WAKE\n" >&$COCKPIT_EVENT_FD' USR1
  printf '%s\n' "${BASHPID:-$$}" >"$dir/${name}.pid"
}

cockpit_event_watch() {
  local path=$1
  shift
  local watch_args=("$@")
  [[ -e "$path" ]] || return 0
  local backend
  backend="$(cockpit_watch_backend)"
  case "$backend" in
    "$COCKPIT_BACKEND_INOTIFY")
      cockpit_inotifywatch_stream "$path" "${watch_args[@]}"
      ;;
    "$COCKPIT_BACKEND_FSWATCH")
      # Same line contract as the inotify backend (--format '%w%f'): one absolute path per
      # line on COCKPIT_EVENT_FD. $! is fswatch itself, so cockpit_event_close
      # reaps it and the normalizer exits on EOF (no orphan watchers).
      local fsw=(fswatch --latency 0.2 -E) i=0
      while ((i < ${#watch_args[@]})); do
        case "${watch_args[$i]}" in
          -r) fsw+=(-r) ;;
          -e) i=$((i + 1)) ;; # inotify event list; fswatch uses the fixed set below
          --exclude)
            i=$((i + 1))
            [[ -n "${watch_args[$i]:-}" ]] && fsw+=(--exclude "${watch_args[$i]}")
            ;;
        esac
        i=$((i + 1))
      done
      fsw+=(--event Created --event Updated --event Removed --event Renamed --event MovedTo "$path")
      "${fsw[@]}" 2>/dev/null > >(cockpit_event_normalize >&"$COCKPIT_EVENT_FD") &
      COCKPIT_INOTIFY_PIDS+=($!)
      ;;
    "$COCKPIT_BACKEND_NONE")
      return 0
      ;;
  esac
}

# FSEvents reports /private/var/... for /var/... paths; emit canonical paths
# so callers comparing against cockpit_realpath'd files still match.
cockpit_event_normalize() {
  local line real
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    real="$(cockpit_realpath "$line" 2>/dev/null)" || real=$line
    printf '%s\n' "${real:-$line}"
  done
}

cockpit_event_read() {
  IFS= read -r COCKPIT_EVENT <&"$COCKPIT_EVENT_FD"
}

cockpit_event_drain() {
  local extra
  while IFS= read -r -t 0.02 -u "$COCKPIT_EVENT_FD" extra; do
    if [[ "$extra" == "WAKE" ]]; then
      COCKPIT_WAKE=1
      continue
    fi
    [[ -n "$extra" ]] && printf '%s\n' "$extra"
  done || true
}

cockpit_event_close() {
  local pid
  for pid in "${COCKPIT_INOTIFY_PIDS[@]+"${COCKPIT_INOTIFY_PIDS[@]}"}"; do
    kill "$pid" 2>/dev/null || true
  done
  exec {COCKPIT_EVENT_FD}>&- 2>/dev/null || true
  [[ -n "${COCKPIT_EVENT_FIFO:-}" ]] && rm -f "$COCKPIT_EVENT_FIFO"
}

cockpit_hush_session() {
  local session=${1:-} w
  [[ -n "$session" ]] || return 0
  tmux set-option -t "$session" bell-action none 2>/dev/null || true
  tmux set-option -t "$session" visual-bell off 2>/dev/null || true
  tmux set-option -t "$session" activity-action none 2>/dev/null || true
  tmux set-option -t "$session" silence-action none 2>/dev/null || true
  tmux set-option -t "$session" allow-passthrough off 2>/dev/null || true
  tmux set-option -t "$session" set-titles off 2>/dev/null || true
  tmux set-option -t "$session" allow-rename off 2>/dev/null || true
  tmux set-hook -t "$session" alert-bell '' 2>/dev/null || true
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    tmux set-option -w -t "$w" monitor-bell off 2>/dev/null || true
    tmux set-option -w -t "$w" monitor-activity off 2>/dev/null || true
    tmux set-option -w -t "$w" monitor-silence 0 2>/dev/null || true
    tmux set-option -w -t "$w" allow-rename off 2>/dev/null || true
  done < <(tmux list-windows -t "$session" -F '#{window_id}' 2>/dev/null || true)
}

cockpit_coalesce() {
  local extra
  while IFS= read -r -t "$COCKPIT_DEBOUNCE" extra; do
    :
  done || true
  return 0
}

cockpit_state_file() {
  printf '%s/state\n' "$(cockpit_config_home)"
}

cockpit_state_write() {
  local session=${1:-} modality=${2:-} endpoint=${3:-}
  local dir
  dir="$(dirname -- "$(cockpit_state_file)")"
  mkdir -p "$dir"
  printf 'session=%s\nmodality=%s\nendpoint=%s\n' "$session" "$modality" "$endpoint" \
    >"$(cockpit_state_file).tmp"
  mv "$(cockpit_state_file).tmp" "$(cockpit_state_file)"
}

cockpit_fingerprint_files() {
  local root=$1
  shift
  if (($# == 0)); then
    printf 'empty\n'
    return 0
  fi
  cockpit_stat_mtime_size "$@" 2>/dev/null | sort
}

# --- Optional Laya routing (C5) ----------------------------------------------
# One decision path: cockpit_route_default, cockpit_route_decide TASK and
# cockpit_route_apply (cockpit_route_run = decide + apply + receipt).
# Absent (no venv), off (enabled=0 or COCKPIT_LAYA=0): file-existence checks
# only, so no curl, no python and nothing on stderr unless COCKPIT_DEBUG=1.
# laya.conf is data: key=value lines are read, never sourced or evaluated, and
# a COCKPIT_LAYA_<KEY> environment variable wins over the file. The bearer key
# stays in the 0600 key file and reaches curl only through a --config pipe
# (never argv, never a temp file). Task text goes to Laya as JSON built by
# json.dumps and sent on stdin; receipts keep only its sha256.

cockpit_laya_data_home() {
  printf '%s/cockpit/laya\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

cockpit_laya_state_home() {
  printf '%s/cockpit/laya\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

cockpit_laya_config_file() {
  printf '%s/laya.conf\n' "$(cockpit_config_home)"
}

cockpit_laya_key_file() {
  printf '%s/api.key\n' "$(cockpit_laya_state_home)"
}

# cockpit_laya_conf_get KEY DEFAULT: last KEY=value line of laya.conf, as text.
cockpit_laya_conf_get() {
  local key=$1 default=${2:-} f line k found="" have=0
  f="$(cockpit_laya_config_file)"
  if [[ -f "$f" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=${line%$'\r'}
      case "$line" in ''|'#'*) continue ;; esac
      [[ "$line" == *=* ]] || continue
      k=${line%%=*}
      k=${k//[[:space:]]/}
      [[ "$k" == "$key" ]] || continue
      found=${line#*=}
      have=1
    done <"$f"
  fi
  if [[ "$have" == 1 ]]; then
    printf '%s\n' "$found"
  else
    printf '%s\n' "$default"
  fi
}

# cockpit_laya_setting KEY DEFAULT: environment first, then laya.conf, then DEFAULT.
cockpit_laya_setting() {
  local key=$1 default=$2 env_value=""
  case "$key" in
    url) env_value=${COCKPIT_LAYA_URL:-} ;;
    timeout_ms) env_value=${COCKPIT_LAYA_TIMEOUT_MS:-} ;;
    min_confidence) env_value=${COCKPIT_LAYA_MIN_CONFIDENCE:-} ;;
    default_tier) env_value=${COCKPIT_LAYA_DEFAULT_TIER:-} ;;
    max_tier) env_value=${COCKPIT_LAYA_MAX_TIER:-} ;;
    device) env_value=${COCKPIT_LAYA_DEVICE:-} ;;
  esac
  if [[ -n "$env_value" ]]; then
    printf '%s\n' "$env_value"
  else
    cockpit_laya_conf_get "$key" "$default"
  fi
}

# COCKPIT_LAYA=0 hard-disables, COCKPIT_LAYA=1 enables; otherwise enabled=1 in laya.conf.
cockpit_laya_enabled() {
  case "${COCKPIT_LAYA:-}" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  [[ "$(cockpit_laya_conf_get enabled 0)" == 1 ]]
}

cockpit_laya_venv_bin() {
  local bin
  bin="$(cockpit_laya_data_home)/venv/bin/$1"
  [[ -x "$bin" ]] || return 1
  printf '%s\n' "$bin"
}

cockpit_laya_installed() {
  cockpit_laya_venv_bin laya-serve >/dev/null && cockpit_laya_venv_bin python >/dev/null
}

# Loopback-only Laya URL (http://127.0.0.1:PORT or http://localhost:PORT), else fail.
cockpit_laya_loopback_url() {
  local url=${1%/}
  [[ "$url" =~ ^http://(127\.0\.0\.1|localhost):([0-9]{1,5})$ ]] || return 1
  ((10#${BASH_REMATCH[2]} >= 1 && 10#${BASH_REMATCH[2]} <= 65535)) || return 1
  printf 'http://%s:%s\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))"
}

cockpit_laya_url() {
  cockpit_laya_loopback_url "$(cockpit_laya_setting url http://127.0.0.1:8765)"
}

cockpit_laya_cfg_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//[[:cntrl:]]/}
  printf '"%s"' "$s"
}

# curl config on stdout: URL, headers and the bearer key read from the key file
# by the shell (read/printf are builtins, so the key is never on any argv).
cockpit_laya_curl_config() {
  local url=$1 keyfile=$2 with_body=$3 key=""
  IFS= read -r key <"$keyfile" || [[ -n "$key" ]] || return 1
  printf 'url = %s\n' "$(cockpit_laya_cfg_quote "$url")"
  printf 'header = "Content-Type: application/json"\n'
  printf 'header = %s\n' "$(cockpit_laya_cfg_quote "Authorization: Bearer ${key}")"
  if [[ "$with_body" == 1 ]]; then
    # Body comes from curl's stdin (the fixed literal "@-"; caller text never sets @).
    printf 'data-binary = "@-"\n'
  fi
}

# cockpit_laya_http URL MAX_TIME_S: POST stdin to URL. Prints the body, then a
# last line "<http_code> <time_total>". Returns curl's exit status.
cockpit_laya_http() {
  local url=$1 max_time=$2 keyfile
  keyfile="$(cockpit_laya_key_file)"
  [[ -r "$keyfile" ]] || return 90
  curl --silent --show-error --max-time "$max_time" \
    --write-out '\n%{http_code} %{time_total}' \
    --config <(cockpit_laya_curl_config "$url" "$keyfile" 1) 2>/dev/null
}

cockpit_route_default() {
  printf '%s\n' codex
}

cockpit_route_valid_tier() {
  case "${1:-}" in cheap|standard|top) return 0 ;; esac
  return 1
}

cockpit_route_tier_rank() {
  case "$1" in cheap) printf 0 ;; standard) printf 1 ;; *) printf 2 ;; esac
}

cockpit_route_task_sha256() {
  # shasum (perl) ships on macOS and ubuntu; openssl is the fallback. C3's
  # portability lint keeps GNU-only digest tools out of bin/.
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    printf '%s' "$1" | openssl dgst -sha256 | awk '{print $NF}'
  fi
}

cockpit_route_receipt_path() {
  printf '%s/cockpit/route.jsonl\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

cockpit_json_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  s=${s//[[:cntrl:]]/}
  printf '"%s"' "$s"
}

cockpit_json_or_null() {
  if [[ -n "${1:-}" ]]; then cockpit_json_quote "$1"; else printf null; fi
}

cockpit_json_number_or_null() {
  if [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then printf '%s' "$1"; else printf null; fi
}

cockpit_json_bool() {
  if [[ "${1:-0}" == 1 ]]; then printf true; else printf false; fi
}

cockpit_route_debug() {
  [[ "${COCKPIT_DEBUG:-}" == 1 ]] || return 0
  printf 'cockpit route: %s\n' "$*" >&2
}

cockpit_route_authlib() {
  declare -F cockpit_auth_field >/dev/null 2>&1 && return 0
  local authlib
  authlib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/cockpit-auth-lib"
  [[ -f "$authlib" ]] || return 1
  # shellcheck source=cockpit-auth-lib
  source "$authlib"
}

# Runtime ids whose providers.conf check= passes, as "id<TAB>label" lines.
cockpit_route_runtime_tools() {
  local id label
  cockpit_route_authlib || return 0
  while IFS= read -r id; do
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    [[ -n "$(cockpit_auth_field "$id" start 2>/dev/null || true)" ]] || continue
    cockpit_auth_check "$id" 2>/dev/null || continue
    label="$(cockpit_auth_field "$id" label 2>/dev/null || true)"
    printf '%s\t%s\n' "$id" "${label:-$id}"
  done < <(cockpit_auth_ids runtime 2>/dev/null)
}

# tiers=cheap:<model>,standard:<model>,top:<model> on the provider → model for TIER.
cockpit_route_tier_model() {
  local provider=$1 tier=$2 tiers_line entry
  cockpit_route_authlib || return 1
  tiers_line="$(cockpit_auth_field "$provider" tiers 2>/dev/null || true)"
  [[ -n "$tiers_line" ]] || return 1
  while IFS= read -r -d , entry; do
    entry=${entry//[[:space:]]/}
    if [[ "${entry%%:*}" == "$tier" && -n "${entry#*:}" && "$entry" == *:* ]]; then
      printf '%s\n' "${entry#*:}"
      return 0
    fi
  done <<<"${tiers_line},"
  return 1
}

cockpit_route_reset() {
  COCKPIT_ROUTE_LAYA=absent
  COCKPIT_ROUTE_TIER=cheap
  COCKPIT_ROUTE_TOOL="$(cockpit_route_default)"
  COCKPIT_ROUTE_CONF_TIER=""
  COCKPIT_ROUTE_CONF_TOOL=""
  COCKPIT_ROUTE_NEEDS_REVIEW=0
  COCKPIT_ROUTE_IS_SENSITIVE=0
  COCKPIT_ROUTE_REASON=""
  COCKPIT_ROUTE_LATENCY_MS=0
  COCKPIT_ROUTE_APPLIED_PROVIDER=""
  COCKPIT_ROUTE_APPLIED_MODEL=""
}

cockpit_route_add_reason() {
  COCKPIT_ROUTE_REASON="${COCKPIT_ROUTE_REASON:+$COCKPIT_ROUTE_REASON,}$1"
}

# Request body for POST /v1/systemone (laya 0.3.x: {"state", "questions"{...}}).
# Task text arrives on stdin and is encoded by json.dumps, never by the shell.
cockpit_route_payload_py='
import json, os, sys
text = sys.stdin.read()
tools = []
for line in os.environ.get("CR_TOOLS", "").splitlines():
    if "\t" in line:
        tid, label = line.split("\t", 1)
        tools.append((tid, label))
langs = [l for l in os.environ.get("CR_LANGS", "").split(",") if l]
state = {"request": text, "repo": os.environ.get("CR_REPO", ""), "languages": langs,
         "changed_files": int(os.environ.get("CR_CHANGED") or 0)}
if os.environ.get("CR_CARD"):
    state["card"] = os.environ["CR_CARD"]
questions = {
    "tier": {"type": "choice", "instructions": "Which model tier does this coding task need?",
             "criteria": {"cheap": "single-file edit, rename, docs, config",
                          "standard": "multi-file feature, tests",
                          "top": "architecture, cross-repo refactor, CI/release, security"}},
    "needs_review": {"type": "noul", "instructions": "Does this change need human review before it merges?"},
    "is_sensitive": {"type": "noul", "instructions": "Does this task touch secrets, authentication or payments?"},
}
if tools:
    questions["tool"] = {"type": "choice", "instructions": "Which coding agent runtime should run this task?",
                         "criteria": {tid: label for tid, label in tools}}
sys.stdout.write(json.dumps({"state": state, "questions": questions}))
'

# Laya answer → "tier|conf_tier|tool|conf_tool|needs_review|is_sensitive", or MALFORMED.
cockpit_route_parse_py='
import json, os, sys
try:
    data = json.loads(sys.stdin.read())
    answers = data["answers"]
    if not isinstance(answers, dict):
        raise TypeError
except Exception:
    print("MALFORMED")
    raise SystemExit(0)
offered = [l.split("\t", 1)[0] for l in os.environ.get("CR_TOOLS", "").splitlines() if l]
def conf(a):
    for k in ("answer_confidence", "confidence"):
        v = a.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1:
            return "%.2f" % v
    return ""
def choice(name, allowed):
    a = answers.get(name)
    if not isinstance(a, dict) or a.get("choice") not in allowed:
        return "", ""
    return a["choice"], conf(a)
def noul(name):
    a = answers.get(name)
    v = a.get("noul") if isinstance(a, dict) else None
    return "1" if isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0.5 else "0"
tier, ct = choice("tier", ("cheap", "standard", "top"))
tool, cl = choice("tool", offered)
print("|".join([tier, ct, tool, cl, noul("needs_review"), noul("is_sensitive")]))
'

cockpit_route_conf_ok() {
  local conf=$1 min=$2
  [[ "$conf" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  awk -v c="$conf" -v m="$min" 'BEGIN { exit (c + 0 >= m + 0) ? 0 : 1 }'
}

# Top languages by tracked-file extension count (names only, no contents).
cockpit_route_languages() {
  git ls-files 2>/dev/null | awk -F. 'NF > 1 { n[$NF]++ } END { for (e in n) print n[e], e }' |
    sort -rn | awk 'NR <= 3 { printf "%s%s", (NR > 1 ? "," : ""), $2 }'
}

cockpit_route_decide() {
  local task=${1:-} default_tier max_tier min_conf timeout_ms url py tools payload
  local response rc status_line http_code time_total body parsed
  local tier conf_tier tool conf_tool needs_review is_sensitive secs frac

  cockpit_route_reset
  default_tier="$(cockpit_laya_setting default_tier cheap)"
  cockpit_route_valid_tier "$default_tier" || default_tier=cheap
  COCKPIT_ROUTE_TIER=$default_tier

  if [[ "${COCKPIT_LAYA:-}" == 0 ]]; then
    COCKPIT_ROUTE_LAYA=off
    cockpit_route_debug "laya off (COCKPIT_LAYA=0)"
    return 0
  fi
  if ! cockpit_laya_installed; then
    cockpit_route_debug "laya absent"
    return 0
  fi
  if ! cockpit_laya_enabled; then
    COCKPIT_ROUTE_LAYA=off
    cockpit_route_debug "laya off (enabled=0)"
    return 0
  fi

  COCKPIT_ROUTE_LAYA=down
  max_tier="$(cockpit_laya_setting max_tier top)"
  cockpit_route_valid_tier "$max_tier" || max_tier=top
  min_conf="$(cockpit_laya_setting min_confidence 0.60)"
  [[ "$min_conf" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || min_conf=0.60
  timeout_ms="$(cockpit_laya_setting timeout_ms 400)"
  [[ "$timeout_ms" =~ ^[0-9]{1,6}$ ]] || timeout_ms=400
  timeout_ms=$((10#$timeout_ms))
  ((timeout_ms >= 50)) || timeout_ms=50
  if ! url="$(cockpit_laya_url)"; then
    COCKPIT_ROUTE_REASON=non_loopback_url
    return 0
  fi
  if [[ ! -r "$(cockpit_laya_key_file)" ]]; then
    COCKPIT_ROUTE_REASON=no_api_key
    return 0
  fi
  py="$(cockpit_laya_venv_bin python)"
  # Load the provider registry in this shell (not only in a $(...) subshell).
  cockpit_route_authlib || true

  tools="$(cockpit_route_runtime_tools)"
  payload="$(printf '%s' "$task" | CR_TOOLS="$tools" CR_REPO="$(basename -- "$PWD")" \
    CR_LANGS="$(cockpit_route_languages)" \
    CR_CHANGED="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')" \
    CR_CARD="${COCKPIT_CARD:-}" "$py" -c "$cockpit_route_payload_py" 2>/dev/null)" || payload=""
  if [[ -z "$payload" ]]; then
    COCKPIT_ROUTE_REASON=payload_failed
    return 0
  fi

  printf -v secs '%d.%03d' "$((timeout_ms / 1000))" "$((timeout_ms % 1000))"
  rc=0
  response="$(printf '%s' "$payload" | cockpit_laya_http "$url/v1/systemone" "$secs")" || rc=$?
  status_line=${response##*$'\n'}
  body=${response%$'\n'*}
  [[ "$response" == *$'\n'* ]] || body=""
  http_code=${status_line%% *}
  time_total=${status_line#* }
  if [[ "$time_total" =~ ^([0-9]+)\.?([0-9]*)$ ]]; then
    frac="${BASH_REMATCH[2]}000"
    COCKPIT_ROUTE_LATENCY_MS=$((10#${BASH_REMATCH[1]} * 1000 + 10#${frac:0:3}))
  fi

  if ((rc == 28)); then
    COCKPIT_ROUTE_LAYA=timeout
    COCKPIT_ROUTE_REASON="timeout_${timeout_ms}ms"
    ((COCKPIT_ROUTE_LATENCY_MS > 0)) || COCKPIT_ROUTE_LATENCY_MS=$timeout_ms
    return 0
  fi
  if ((rc != 0)); then
    COCKPIT_ROUTE_REASON="curl_exit_${rc}"
    return 0
  fi
  if [[ "$http_code" != 200 ]]; then
    COCKPIT_ROUTE_REASON="http_${http_code}"
    return 0
  fi

  parsed="$(printf '%s' "$body" | CR_TOOLS="$tools" "$py" -c "$cockpit_route_parse_py" 2>/dev/null)" || parsed=""
  if [[ -z "$parsed" || "$parsed" == MALFORMED ]]; then
    COCKPIT_ROUTE_REASON=malformed_json
    return 0
  fi
  IFS='|' read -r tier conf_tier tool conf_tool needs_review is_sensitive <<<"$parsed"

  COCKPIT_ROUTE_LAYA=ok
  COCKPIT_ROUTE_CONF_TIER=$conf_tier
  COCKPIT_ROUTE_CONF_TOOL=$conf_tool
  COCKPIT_ROUTE_NEEDS_REVIEW=$needs_review
  COCKPIT_ROUTE_IS_SENSITIVE=$is_sensitive
  if [[ -n "$tier" ]] && cockpit_route_conf_ok "$conf_tier" "$min_conf"; then
    if (($(cockpit_route_tier_rank "$tier") > $(cockpit_route_tier_rank "$max_tier"))); then
      tier=$max_tier
      cockpit_route_add_reason clamped_to_max_tier
    fi
    COCKPIT_ROUTE_TIER=$tier
  else
    cockpit_route_add_reason low_confidence_tier
  fi
  if [[ -n "$tool" ]] && cockpit_route_conf_ok "$conf_tool" "$min_conf"; then
    COCKPIT_ROUTE_TOOL=$tool
  else
    cockpit_route_add_reason low_confidence_tool
  fi
  cockpit_route_debug "laya ok tier=$COCKPIT_ROUTE_TIER tool=$COCKPIT_ROUTE_TOOL"
  return 0
}

# Only a real Laya answer changes anything: export COCKPIT_PROVIDER/COCKPIT_MODEL
# from the provider's tiers= map and run its existing model_apply hook.
cockpit_route_apply() {
  local model apply_cmd
  COCKPIT_ROUTE_APPLIED_PROVIDER=""
  COCKPIT_ROUTE_APPLIED_MODEL=""
  [[ "${COCKPIT_ROUTE_LAYA:-}" == ok ]] || return 0
  cockpit_route_authlib || return 0
  model="$(cockpit_route_tier_model "$COCKPIT_ROUTE_TOOL" "$COCKPIT_ROUTE_TIER")" || return 0
  COCKPIT_ROUTE_APPLIED_PROVIDER=$COCKPIT_ROUTE_TOOL
  COCKPIT_ROUTE_APPLIED_MODEL=$model
  export COCKPIT_PROVIDER="$COCKPIT_ROUTE_TOOL" COCKPIT_MODEL="$model"
  apply_cmd="$(cockpit_auth_field "$COCKPIT_ROUTE_TOOL" model_apply 2>/dev/null || true)"
  if [[ -n "$apply_cmd" ]] && ! bash -lc "$apply_cmd" </dev/null >/dev/null 2>&1; then
    cockpit_route_add_reason model_apply_failed
  fi
  return 0
}

cockpit_route_receipt_json() {
  local task_sha=$1 ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '{"ts":%s,"laya":%s,"latency_ms":%s,"task_sha256":%s,"tier":%s,"tool":%s,"conf":{"tier":%s,"tool":%s},"needs_review":%s,"is_sensitive":%s,"applied":{"provider":%s,"model":%s},"reason":%s}' \
    "$(cockpit_json_quote "$ts")" \
    "$(cockpit_json_quote "$COCKPIT_ROUTE_LAYA")" \
    "$(cockpit_json_number_or_null "$COCKPIT_ROUTE_LATENCY_MS")" \
    "$(cockpit_json_quote "$task_sha")" \
    "$(cockpit_json_quote "$COCKPIT_ROUTE_TIER")" \
    "$(cockpit_json_quote "$COCKPIT_ROUTE_TOOL")" \
    "$(cockpit_json_number_or_null "$COCKPIT_ROUTE_CONF_TIER")" \
    "$(cockpit_json_number_or_null "$COCKPIT_ROUTE_CONF_TOOL")" \
    "$(cockpit_json_bool "$COCKPIT_ROUTE_NEEDS_REVIEW")" \
    "$(cockpit_json_bool "$COCKPIT_ROUTE_IS_SENSITIVE")" \
    "$(cockpit_json_or_null "$COCKPIT_ROUTE_APPLIED_PROVIDER")" \
    "$(cockpit_json_or_null "$COCKPIT_ROUTE_APPLIED_MODEL")" \
    "$(cockpit_json_or_null "$COCKPIT_ROUTE_REASON")"
}

# Receipt: one JSON line per decision; never the task text, only its sha256.
cockpit_route_write_receipt() {
  local file
  file="$(cockpit_route_receipt_path)"
  {
    mkdir -p "$(dirname -- "$file")" &&
      printf '%s\n' "$(cockpit_route_receipt_json "$(cockpit_route_task_sha256 "$1")")" >>"$file"
  } 2>/dev/null || true
}

# cockpit_route_run TASK [--dry-run]: decide, apply (unless dry-run), write receipt.
cockpit_route_run() {
  local task=$1 mode=${2:-}
  cockpit_route_decide "$task"
  if [[ "$mode" != --dry-run ]]; then
    cockpit_route_apply
  fi
  cockpit_route_write_receipt "$task"
  return 0
}
