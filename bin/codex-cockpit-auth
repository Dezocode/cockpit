#!/usr/bin/env bash
# Generic cockpit auth: providers from ~/.config/codex-cockpit/providers.conf
# Login runs in a tmux popup you can click out of. Success closes the box.
set -euo pipefail

lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-auth-lib"
# shellcheck source=codex-cockpit-auth-lib
source "$lib"

blue=$'\033[38;5;4m'
muted=$'\033[38;5;8m'
bright=$'\033[1;37m'
reset=$'\033[0m'

cmd="${1:-pick}"
id="${2:-}"

open_popup() {
  local id=$1 label
  label="$(cockpit_auth_label "$id")"
  if [[ -z "${TMUX:-}" ]]; then
    exec "$0" run "$id"
  fi
  # -E: close when the login process exits (success or failure).
  # No -B: a click outside the box dismisses it without finishing login.
  cockpit_popup "Auth · ${label}" "codex-cockpit-auth run $(printf %q "$id")"
}

run_login() {
  local id=$1 login
  login="$(cockpit_auth_login_cmd "$id" || true)"
  if [[ -z "$login" ]]; then
    printf 'No login command for provider %s\n' "$id" >&2
    exit 1
  fi
  printf '%s%s%s\n' "$muted" "Click outside this box to cancel. It closes on success." "$reset"
  printf '%s\n\n' "$login"
  set +e
  bash -lc "$login"
  local st=$?
  set -e
  if cockpit_auth_signed_in "$id"; then
    printf '\n%sSigned in. Closing this box.%s\n' "$bright" "$reset"
    sleep 0.6
    exit 0
  fi
  exit "$st"
}

draw_gate() {
  local id=$1 label=$2
  printf '\033[2J\033[H'
  printf '%s╭──────────────────────────────────────────────╮%s\n' "$blue" "$reset"
  printf '%s│%s  %s%s%s auth%s\n' "$blue" "$reset" "$bright" "$label" "$reset" "$blue"
  printf '%s╰──────────────────────────────────────────────╯%s\n\n' "$blue" "$reset"
  printf 'Not signed in.\n\n'
  printf '  %s[ Auth ]%s     %s[ Not now ]%s\n\n' "$bright" "$reset" "$muted" "$reset"
  printf '%sEnter / a / click Auth  ·  q skip  ·  nested login box is click-out%s\n' "$muted" "$reset"
}

gate() {
  local id=$1 label ready
  [[ -n "$id" ]] || exit 1
  cockpit_auth_ensure_config
  label="$(cockpit_auth_label "$id")"
  ready="$(cockpit_auth_ready_cmd "$id")"

  while true; do
    if cockpit_auth_signed_in "$id"; then
      if [[ -n "$ready" ]]; then
        exec bash -lc "$ready"
      fi
      printf '%s%s is signed in.%s\n' "$bright" "$label" "$reset"
      printf 'q to leave this pane idle.\n'
      while IFS= read -rsn1 k; do
        [[ "$k" == "q" || "$k" == $'\033' ]] && exit 0
      done
    fi

    draw_gate "$id" "$label"
    printf '\033[?1000h\033[?1006h'
    local key="" acc
    IFS= read -rsn1 key || true
    if [[ "$key" == $'\033' ]]; then
      IFS= read -rsn1 -t 0.05 acc || true
      if [[ "$acc" == "[" ]]; then
        IFS= read -rsn1 -t 0.05 acc || true
        if [[ "$acc" == "<" ]]; then
          local seq="" c
          while IFS= read -rsn1 -t 0.05 c; do
            seq+="$c"
            [[ "$c" == "M" || "$c" == "m" ]] && break
          done
          printf '\033[?1000l\033[?1006l'
          # SGR: btn;x;yM  — treat a press (M, btn 0) as Auth.
          if [[ "$seq" == 0\;*M ]]; then
            open_popup "$id"
            continue
          fi
          continue
        fi
      fi
      printf '\033[?1000l\033[?1006l'
      continue
    fi
    printf '\033[?1000l\033[?1006l'
    case "$key" in
      a|A|''|$'\n'|$'\r') open_popup "$id" ;;
      q|Q) ;;
    esac
  done
}

pick() {
  cockpit_auth_ensure_config
  local ids id n=0 sel
  mapfile -t ids < <(cockpit_auth_ids cli-oauth)
  if ((${#ids[@]} == 0)); then
    mapfile -t ids < <(cockpit_auth_ids)
    # Drop runtime entries from the OAuth picker.
    local filtered=() k
    for id in "${ids[@]}"; do
      k="$(cockpit_auth_kind "$id")"
      [[ "$k" == "runtime" ]] && continue
      filtered+=("$id")
    done
    ids=("${filtered[@]}")
  fi
  if ((${#ids[@]} == 0)); then
    printf 'No providers in %s\n' "$cockpit_auth_file" >&2
    exit 1
  fi
  if ((${#ids[@]} == 1)); then
    printf '%s\n' "${ids[0]}"
    return 0
  fi
  {
    printf '%sAuth sources%s\n\n' "$bright" "$reset"
    for id in "${ids[@]}"; do
      n=$((n + 1))
      if cockpit_auth_signed_in "$id"; then
        printf '  %s) %s  %sready%s\n' "$n" "$(cockpit_auth_label "$id")" "$muted" "$reset"
      elif cockpit_auth_check "$id"; then
        printf '  %s) %s  %sneeds auth%s\n' "$n" "$(cockpit_auth_label "$id")" "$blue" "$reset"
      else
        printf '  %s) %s  %snot installed%s\n' "$n" "$(cockpit_auth_label "$id")" "$muted" "$reset"
      fi
    done
    printf '\nq / Esc close · tap CODEX to return (desktop: click outside)\nNumber, or q: '
  } >/dev/tty
  read -r sel </dev/tty
  [[ "$sel" == "q" || -z "$sel" ]] && exit 0
  if [[ "$sel" =~ ^[0-9]+$ ]] && ((sel >= 1 && sel <= ${#ids[@]})); then
    printf '%s\n' "${ids[sel-1]}"
    return 0
  fi
  printf '%s\n' "$sel"
}

case "$cmd" in
  check)
    cockpit_auth_check "$id"
    ;;
  run)
    run_login "$id"
    ;;
  gate)
    gate "$id"
    ;;
  popup)
    if [[ -z "$id" ]]; then
      id="$(pick)"
      [[ -n "$id" ]] || exit 0
    fi
    open_popup "$id"
    ;;
  pick|*)
    if [[ "$cmd" != "pick" && -n "$cmd" && "$cmd" != "popup" ]]; then
      id=$cmd
      open_popup "$id"
      exit 0
    fi
    id="$(pick)"
    [[ -n "$id" ]] || exit 0
    open_popup "$id"
    ;;
esac
