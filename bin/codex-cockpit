#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "config" ]]; then
  shift
  exec "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-config" "$@"
fi

root="${1:-$PWD}"
diagram="${2:-}"
explicit_root=$(( $# > 0 ? 1 : 0 ))

if [[ ! -d "$root" ]]; then
  printf 'codex-cockpit: directory not found: %s\n' "$root" >&2
  exit 1
fi

root="$(cd -- "$root" && pwd -P)"

is_project_dir() {
  local dir=$1
  [[ -d "$dir/.git" || -f "$dir/README.md" || -f "$dir/package.json" ||
    -f "$dir/go.mod" || -f "$dir/Cargo.toml" || -f "$dir/pyproject.toml" ||
    -f "$dir/Makefile" ]]
}

# A freshly initialized home directory is technically a Git worktree, but it
# is a disastrous cockpit root. Treat an empty home worktree as a container
# for projects instead of as the project itself.
usable_git_root() {
  local dir=$1
  if [[ "$dir" == "$HOME" ]] && ! git -C "$dir" rev-parse --verify HEAD >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

git_root="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$git_root" ]] && usable_git_root "$git_root"; then
  root="$(cd -- "$git_root" && pwd -P)"
elif is_project_dir "$root"; then
  :
elif (( explicit_root == 0 )) && [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  candidates="$(find "$HOME/Work" -mindepth 1 -maxdepth 2 -type d \
    \( -name .git -o -name node_modules -o -name .cache \) -prune -o \
    -type d -print 2>/dev/null | while IFS= read -r candidate; do
      if is_project_dir "$candidate"; then
        printf '%s\n' "$candidate"
      fi
    done | sort -u || true)"
  if [[ -n "$candidates" ]]; then
    selected="$(printf '%s\n' "$candidates" | fzf \
      --height=55% --layout=reverse --border=rounded \
      --prompt='project › ' \
      --header='Choose a project  •  Enter open  •  Esc cancel' \
      --preview='git -C {} status --short --branch 2>/dev/null | head -20 || find {} -maxdepth 1 -type f -printf "%f\\n" | head -20' \
      --preview-window=right:45%:wrap || true)"
    if [[ -z "$selected" ]]; then
      exit 0
    fi
    root="$(cd -- "$selected" && pwd -P)"
  else
    printf 'codex-cockpit: no projects found under %s\n' "$HOME/Work" >&2
    exit 1
  fi
else
  printf 'codex-cockpit: %s is not a project directory\n' "$root" >&2
  printf 'Run `codex` inside a project, or pass its path: codex /path/to/project\n' >&2
  exit 1
fi

# One canonical runtime. Project path is the pane cwd, not extra sessions.
session="${CODEX_COCKPIT_SESSION:-codex-cockpit}"

reap_ghost_sessions() {
  local name attached
  while IFS=$'\t' read -r name attached; do
    [[ "$name" == "$session" ]] && continue
    [[ "$name" == codex-cockpit-* ]] || continue
    if [[ "${attached:-0}" == "0" ]]; then
      tmux kill-session -t "$name" 2>/dev/null || true
    fi
  done < <(tmux list-sessions -F '#{session_name}\t#{session_attached}' 2>/dev/null || true)
}

quote_sh() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\'/\'\\\'\'}
  printf "'%s'" "$value"
}

root_q="$(quote_sh "$root")"
mermaid_args="$root_q"
if [[ -n "$diagram" ]]; then
  mermaid_args+=" $(quote_sh "$diagram")"
fi

export PATH="$HOME/.local/bin:$PATH"

if command -v tmux >/dev/null 2>&1; then
  reap_ghost_sessions
fi

# GitHub: use local gh CLI status. Already signed in → no prompt.
# Unsigned → one nested box (click-out skips). Does not touch Codex/Grok OAuth.

modality=${COCKPIT_MODALITY:-}
if [[ -z "$modality" && -t 0 && -t 1 && -z "${COCKPIT_SKIP_GATE:-}" ]]; then
  modality="$(codex-cockpit-gate 2>/dev/null || true)"
fi
if [[ "$modality" != "keyboard" && "$modality" != "touch" ]]; then
  if [[ "$(codex-cockpit-profile $$ 2>/dev/null || true)" == "termius-ios" ]]; then
    modality=touch
  else
    modality=keyboard
  fi
fi

if tmux has-session -t "$session" 2>/dev/null; then
  if [[ -t 1 ]]; then
    tmux set-option -t "$session" @cockpit_modality "$modality" 2>/dev/null || true
    codex-cockpit-idle "$session" >/dev/null 2>&1 &
    exec tmux attach-session -t "$session"
  fi
  printf 'codex-cockpit: session %s already running\n' "$session"
  exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
  printf 'codex-cockpit: codex is not on PATH\n' >&2
  exit 1
fi

codex_bin="${CODEX_CLI_BIN:-$(command -v codex)}"
if [[ ! -x "$codex_bin" ]]; then
  printf 'codex-cockpit: Codex CLI is not executable: %s\n' "$codex_bin" >&2
  exit 1
fi

if ! command -v nvim >/dev/null 2>&1; then
  printf 'codex-cockpit: nvim is not on PATH\n' >&2
  exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf 'codex-cockpit: tmux is not on PATH\n' >&2
  exit 1
fi

overlay="${HOME}/.config/tmux/codex-cockpit.conf"
if [[ ! -f "$overlay" ]]; then
  overlay="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/stage/tmux/codex-cockpit.conf"
fi
if [[ -f "$overlay" ]]; then
  tmux source-file "$overlay" 2>/dev/null || true
fi
codex-cockpit-hooks-install >/dev/null 2>&1 || true
codex-cockpit-probe-install >/dev/null 2>&1 || true

authlib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-auth-lib"
# shellcheck source=codex-cockpit-auth-lib
[[ -f "$authlib" ]] && source "$authlib"
cockpit_auth_ensure_config 2>/dev/null || true
if [[ -t 0 && -t 1 && -z "${COCKPIT_SKIP_GH_AUTH:-}" ]]; then
  cockpit_auth_signed_in github 2>/dev/null || cockpit_auth_ensure github || true
fi
runtime_id=codex
if [[ -f "$HOME/.config/codex-cockpit/state" ]]; then
  runtime_id="$(awk -F= '/^runtime=/{print $2}' "$HOME/.config/codex-cockpit/state" | tail -1)"
fi
[[ -n "$runtime_id" ]] || runtime_id=codex
if [[ -n "${authlib:-}" ]] && ! cockpit_auth_check "$runtime_id" 2>/dev/null; then
  runtime_id=codex
fi
runtime_cmd="$(cockpit_auth_field "$runtime_id" start 2>/dev/null || true)"
[[ -n "$runtime_cmd" ]] || runtime_cmd="$codex_bin"

profile="$(codex-cockpit-profile $$ 2>/dev/null || echo foot)"

tag() {
  local target=$1 title=$2 role=$3
  tmux select-pane -t "$target" -T "$title"
  tmux set-option -p -t "$target" @cockpit_role "$role"
}

# One create path: windows, then adapt morphs pad vs tabs from modality + size.
tmux new-session -d -s "$session" -n CODEX -c "$root" \
  "cd -- $root_q && exec $runtime_cmd"
tag "$session:CODEX" "$(cockpit_auth_label "$runtime_id" 2>/dev/null || echo CODEX)" runtime
tmux set-option -p -t "$session:CODEX" @cockpit_runtime_id "$runtime_id"

tmux new-window -d -t "$session:" -n FILES -c "$root" \
  "cd -- $root_q && exec codex-cockpit-files $root_q"
tag "$session:FILES" FILES files

tmux new-window -d -t "$session:" -n DIFF -c "$root" \
  "cd -- $root_q && exec codex-cockpit-diff $root_q"
tag "$session:DIFF" DIFF diff

tmux new-window -d -t "$session:" -n MAP -c "$root" \
  "cd -- $root_q && exec codex-mermaid-watch $mermaid_args"
tag "$session:MAP" MAP map

tmux new-window -d -t "$session:" -n prs -c "$root" "exec codex-cockpit-prs"
tag "$session:prs" PRS prs

tmux select-window -t "$session:1"
tmux select-pane -t "$session:1.1"
tmux set-option -t "$session" @cockpit 1
tmux set-option -t "$session" @cockpit_modality "$modality"
tmux set-option -t "$session" @cockpit_runtime "$runtime_id"
tmux set-hook -t "$session" after-select-window \
  'run-shell -b "codex-cockpit-wake #{session_name} #{window_name}"; run-shell -b "codex-cockpit-popup gc"'
tmux set-hook -t "$session" after-new-window \
  'set-option -w monitor-bell off ; set-option -w monitor-activity off ; set-option -w monitor-silence 0'
tmux set-hook -t "$session" after-select-pane \
  'run-shell -b "codex-cockpit-wake #{session_name} #{@cockpit_role}"'

tmux list-windows -t "$session" -F '#{window_id}' | while IFS= read -r wid; do
  tmux set-option -w -t "$wid" automatic-rename off
  tmux set-option -w -t "$wid" allow-rename off
done

if command -v omarchy-theme-set-tmux >/dev/null 2>&1; then
  omarchy-theme-set-tmux >/dev/null 2>&1 || true
fi

codex-cockpit-adapt attached "$session" "${COLUMNS:-0}" "${LINES:-0}" "$$" || true
codex-cockpit-ensure-bar "$session" >/dev/null 2>&1 || true
codex-cockpit-probe-install >/dev/null 2>&1 || true
codex-cockpit-idle "$session" >/dev/null 2>&1 &

if [[ -t 1 ]]; then
  exec tmux attach-session -t "$session"
fi

printf 'codex-cockpit: started session %s (%s, %s)\n' "$session" "$profile" "$modality"
