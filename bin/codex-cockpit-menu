#!/usr/bin/env bash
set -euo pipefail

session="${1:-}"
[[ -n "$session" ]] || exit 0

tmux display-menu -T "Cockpit" -x M -y M \
  "Runtime" r "run-shell 'codex-cockpit-touch \"$session\" runtime'" \
  "Switch runtime" e "run-shell 'codex-cockpit-runtime popup \"$session\"'" \
  "Files" f "run-shell 'codex-cockpit-touch \"$session\" files'" \
  "Diff" d "run-shell 'codex-cockpit-touch \"$session\" diff'" \
  "Map" m "run-shell 'codex-cockpit-touch \"$session\" map'" \
  "PRs" p "run-shell 'codex-cockpit-touch \"$session\" prs'" \
  "" \
  "Auth GitHub" G "run-shell 'codex-cockpit-auth popup github'" \
  "Auth…" A "run-shell 'codex-cockpit-auth popup'" \
  "" \
  "Help" h "run-shell 'codex-cockpit-touch \"$session\" help'"
