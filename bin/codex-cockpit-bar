#!/usr/bin/env bash
# Agent toolbar: AUTH · runtime · MODEL as the same pills as the tab row.
# Keyboard and first tap. Never wraps the Codex PTY. Never forwards CSI.
set -euo pipefail

lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-auth-lib"
# shellcheck source=codex-cockpit-auth-lib
[[ -f "$lib" ]] && source "$lib"

reset=$'\033[0m'
# Match tmux touch tabs: dim chip vs black-on-brightyellow current.
idle=$'\033[38;5;250m\033[48;5;238m'
on=$'\033[1;38;5;16m\033[48;5;11m'

session="${1:-}"
if [[ "${1:-}" == "click" ]]; then
  session="${4:-}"
fi
if [[ -z "$session" && -n "${TMUX:-}" ]]; then
  session="$(tmux display-message -p '#{session_name}')"
fi
session="${session:-codex-cockpit}"

rid() {
  tmux show-options -v -t "$session" @cockpit_runtime 2>/dev/null || echo codex
}

label() {
  local id=$1
  if command -v cockpit_auth_label >/dev/null 2>&1; then
    cockpit_auth_label "$id" 2>/dev/null || printf '%s\n' "$id"
  else
    printf '%s\n' "$id"
  fi
}

pane_size() {
  local p=${1:-${TMUX_PANE:-}}
  cols=80
  rows=6
  if [[ -n "$p" ]]; then
    cols="$(tmux display-message -p -t "$p" '#{pane_width}' 2>/dev/null || echo 80)"
    rows="$(tmux display-message -p -t "$p" '#{pane_height}' 2>/dev/null || echo 6)"
  fi
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
  [[ "$rows" =~ ^[0-9]+$ ]] || rows=6
  if ((cols < 24)); then cols=24; fi
  if ((rows < 3)); then rows=3; fi
  return 0
}

center() {
  local text=$1 width=$2
  local n=${#text}
  local left=0 right=0
  if ((n >= width)); then
    printf '%s' "${text:0:width}"
    return 0
  fi
  left=$(( (width - n) / 2 ))
  right=$(( width - n - left ))
  printf '%*s%s%*s' "$left" "" "$text" "$right" ""
  return 0
}

# One row of a status-style chip: solid bg, optional centered label.
chip_row() {
  local sty=$1 text=$2 width=$3 show=$4
  printf '%s' "$sty"
  if [[ "$show" == "1" ]]; then
    center "$text" "$width"
  else
    printf '%*s' "$width" ""
  fi
  printf '%s' "$reset"
}

draw() {
  local id name cols rows gap box_w label_row i show end
  local l1 l2 l3
  pane_size "${TMUX_PANE:-}"
  id="$(rid)"
  name="$(label "$id")"
  name=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
  gap=1
  box_w=$(( (cols - gap * 2) / 3 ))
  if ((box_w < 8)); then box_w=8; fi
  label_row=$((rows / 2))
  l1=AUTH
  l2=$name
  l3=MODEL

  printf '\033[2J\033[H'
  for i in $(seq 0 $((rows - 1))); do
    end=$'\n'
    if ((i == rows - 1)); then end=; fi
    show=0
    if ((i == label_row)); then show=1; fi
    chip_row "$idle" "$l1" "$box_w" "$show"
    printf '%*s' "$gap" ""
    chip_row "$on" "$l2" "$box_w" "$show"
    printf '%*s' "$gap" ""
    chip_row "$idle" "$l3" "$box_w" "$show"
    printf '%s' "$end"
  done
}

open_auth() {
  if command -v cockpit_popup >/dev/null 2>&1; then
    cockpit_popup "AUTH" "codex-cockpit-auth popup"
  else
    tmux display-popup -E -w 88% -h 82% -T "AUTH" "codex-cockpit-auth popup" 2>/dev/null || true
  fi
}

open_runtime() {
  if command -v cockpit_popup >/dev/null 2>&1; then
    cockpit_popup "RUN" "codex-cockpit-runtime pick ${session}"
  else
    tmux display-popup -E -w 76% -h 64% -T "RUN" \
      "codex-cockpit-runtime pick ${session}" 2>/dev/null || true
  fi
}

open_model() {
  codex-cockpit-runtime model "$session" 2>/dev/null || true
}

which_btn() {
  local x=${1:-0} w=${2:-80} third
  [[ "$x" =~ ^[0-9]+$ ]] || x=0
  [[ "$w" =~ ^[0-9]+$ ]] || w=80
  if ((w < 3)); then w=3; fi
  third=$((w / 3))
  if ((x < third)); then
    printf 'auth\n'
  elif ((x < third * 2)); then
    printf 'runtime\n'
  else
    printf 'model\n'
  fi
}

run_btn() {
  case "${1:-}" in
    auth) open_auth ;;
    runtime) open_runtime ;;
    model) open_model ;;
  esac
}

if [[ "${1:-}" == "click" ]]; then
  x=${2:-0}
  pane=${3:-}
  session="${4:-$session}"
  if [[ -z "$pane" ]]; then
    exit 0
  fi
  role="$(tmux display-message -p -t "$pane" '#{@cockpit_role}' 2>/dev/null || true)"
  if [[ "$role" != "bar" ]]; then
    # Swallow the tap: select only. Never send CSI into FILES/DIFF/MAP/PRS.
    tmux select-pane -t "$pane" 2>/dev/null || true
    exit 0
  fi
  w="$(tmux display-message -p -t "$pane" '#{pane_width}' 2>/dev/null || echo 80)"
  run_btn "$(which_btn "$x" "$w")"
  pid="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -WINCH "$pid" 2>/dev/null || true
  exit 0
fi

printf '\033[?25l'
trap 'printf "\033[?25h"' EXIT
trap 'draw' WINCH
draw
while true; do
  key=""
  IFS= read -rsn1 key || true
  case "$key" in
    a|A) run_btn auth; draw ;;
    e|E|r|R) run_btn runtime; draw ;;
    m|M) run_btn model; draw ;;
    '') draw ;;
    $'\033')
      # Eat CSI / leftover Termius mouse. Do not forward into any pane.
      acc=""
      IFS= read -rsn1 -t 0.05 acc || true
      if [[ "$acc" == "[" || "$acc" == "O" ]]; then
        while IFS= read -rsn1 -t 0.05 acc; do
          case "$acc" in
            M|m|~|[A-Z]) break ;;
          esac
        done || true
      fi
      draw
      ;;
    *) draw ;;
  esac
done
