#!/usr/bin/env bash
# Thin shim → app/server/gev/keysCli.mjs (ported store).
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
node_bin="${COCKPIT_TEST_NODE:-$(command -v node 2>/dev/null || true)}"
if [[ -z "$node_bin" || ! -x "$node_bin" ]]; then
  echo "cockpit keys: node is required. Install Node 22+ from https://nodejs.org" >&2
  exit 1
fi
exec "$node_bin" "$root/app/server/gev/keysCli.mjs" "$@"
