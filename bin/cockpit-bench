#!/usr/bin/env bash
# Cockpit BENCH: ghui/FILES-grammar drill over Proctor bench receipts (read-only).
# L1 models → L2 runs → L3 run+backlinks. Enter on backlink jumps peer run; Esc pops stack.
set -euo pipefail

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=cockpit-lib
source "$script_root/cockpit-lib"
export PATH="$script_root:$HOME/.local/bin:$PATH"

BENCH_ROOT=''
BENCH_SOURCE=''

bench_intercom_root() {
  local candidate="${COCKPIT_PROCTOR_HOME:-${COCKPIT_INTERCOM_HOME:-$HOME/intercom}/proctor}"
  [[ -d "$candidate" ]] && printf '%s\n' "$candidate"
}

bench_resolve_root() {
  local intercom
  intercom="$(bench_intercom_root || true)"
  if [[ -n "$intercom" && -f "$intercom/db/runs.sqlite" ]]; then
    BENCH_ROOT="$intercom"
    BENCH_SOURCE=intercom
    return 0
  fi
  BENCH_ROOT=''
  BENCH_SOURCE=''
  return 1
}

bench_db() {
  [[ -n "$BENCH_ROOT" ]] || bench_resolve_root || return 1
  printf '%s/db/runs.sqlite\n' "$BENCH_ROOT"
}

bench_models_index() {
  [[ -n "$BENCH_ROOT" ]] || bench_resolve_root || return 1
  local path="$BENCH_ROOT/MODELS_INDEX.csv"
  [[ -f "$path" ]] && printf '%s\n' "$path"
}

bench_crossref() {
  [[ -n "$BENCH_ROOT" ]] || bench_resolve_root || return 1
  local path="$BENCH_ROOT/CROSSREF_LINKS.csv"
  [[ -f "$path" ]] && printf '%s\n' "$path"
}

bench_sqlite() {
  command -v sqlite3 >/dev/null 2>&1 || {
    printf 'BENCH unavailable: sqlite3 is required to read bench receipts.\n' >&2
    return 1
  }
  local db
  db="$(bench_db)" || return 1
  sqlite3 -readonly -noheader -separator $'\t' "$db" "$@"
}

bench_schema_ok() {
  local db schema
  command -v sqlite3 >/dev/null 2>&1 || return 1
  db="$(bench_db)" || return 1
  schema="$(sqlite3 -readonly -noheader "$db" '
    SELECT CASE WHEN
      (SELECT COUNT(*) FROM pragma_table_info('"'"'models'"'"')
        WHERE name IN ('"'"'model_id'"'"','"'"'agent_class'"'"','"'"'home_path'"'"','"'"'notes'"'"')) = 4
      AND (SELECT COUNT(*) FROM pragma_table_info('"'"'runs'"'"')
        WHERE name IN ('"'"'run_id'"'"','"'"'model_id'"'"','"'"'role'"'"','"'"'campaign'"'"','"'"'disposition'"'"','"'"'scored_at'"'"','"'"'payload_json'"'"')) = 7
      AND (SELECT COUNT(*) FROM pragma_table_info('"'"'run_links'"'"')
        WHERE name IN ('"'"'from_run_id'"'"','"'"'to_run_id'"'"','"'"'link_kind'"'"')) = 3
      THEN 1 ELSE 0 END;')" || return 1
  [[ "$schema" == "1" ]]
}

bench_records_ok() {
  local db invalid
  db="$(bench_db)" || return 1
  invalid="$(sqlite3 -readonly -noheader "$db" \
    "SELECT
       (SELECT COUNT(*) FROM models
          WHERE trim(COALESCE(model_id, '')) = ''
             OR trim(COALESCE(agent_class, '')) = ''
             OR trim(COALESCE(home_path, '')) = '')
       + (SELECT COUNT(*) FROM runs r
            LEFT JOIN models m ON m.model_id = r.model_id
          WHERE trim(COALESCE(r.run_id, '')) = ''
             OR m.model_id IS NULL
             OR trim(COALESCE(r.payload_json, '')) = '')" 2>/dev/null)" || return 1
  [[ "$invalid" == "0" ]]
}

bench_links_ok() {
  local db dangling
  db="$(bench_db)" || return 1
  dangling="$(sqlite3 -readonly -noheader "$db" \
    "SELECT COUNT(*) FROM run_links l
       LEFT JOIN runs from_run ON from_run.run_id = l.from_run_id
       LEFT JOIN runs to_run ON to_run.run_id = l.to_run_id
       WHERE l.link_kind = 'sol_session_ref'
         AND from_run.run_id IS NOT NULL AND to_run.run_id IS NULL;" 2>/dev/null)" || return 1
  [[ "$dangling" == "0" ]]
}

bench_validate() {
  local db
  command -v sqlite3 >/dev/null 2>&1 || {
    printf 'BENCH unavailable: sqlite3 is required to read the Proctor mirror.\n' >&2
    return 1
  }
  if ! bench_resolve_root; then
    printf 'BENCH unavailable: no Proctor mirror found (checked ~/intercom/proctor).\n' >&2
    return 1
  fi
  db="$(bench_db)"
  if [[ ! -r "$db" ]]; then
    printf 'BENCH unavailable: runs.sqlite is not readable: %s\n' "$db" >&2
    return 1
  fi
  if ! bench_schema_ok; then
    printf 'BENCH unavailable: runs.sqlite is missing models/runs/run_links tables: %s\n' "$db" >&2
    return 1
  fi
  if ! bench_models_index >/dev/null 2>&1; then
    printf 'BENCH unavailable: MODELS_INDEX.csv is missing under %s\n' "$BENCH_ROOT" >&2
    return 1
  fi
  if [[ ! -r "$(bench_models_index)" ]]; then
    printf 'BENCH unavailable: MODELS_INDEX.csv is not readable under %s\n' "$BENCH_ROOT" >&2
    return 1
  fi
  if ! bench_records_ok; then
    printf 'BENCH unavailable: a model or run receipt is incomplete\n' >&2
    return 1
  fi
  if ! bench_links_ok; then
    printf 'BENCH unavailable: a backlink target is missing from the Proctor mirror\n' >&2
    return 1
  fi
  return 0
}

bench_display_label() {
  if [[ -z "$BENCH_ROOT" ]]; then
    bench_resolve_root >/dev/null 2>&1 || true
  fi
  if [[ -n "$BENCH_ROOT" ]]; then
    printf '%s (%s)' "$BENCH_ROOT" "${BENCH_SOURCE:-unknown}"
  else
    printf 'managed proctor receipt'
  fi
}

bench_models_lines() {
  local lines
  bench_validate >/dev/null 2>&1 || return 1
  lines="$(bench_sqlite "SELECT model_id, agent_class FROM models ORDER BY model_id;")"
  if [[ -n "$lines" ]]; then
    printf '%s\n' "$lines"
  else
    printf 'ABSENT\n'
  fi
}

bench_runs_lines() {
  local model_id=$1 lines
  bench_validate >/dev/null 2>&1 || return 1
  lines="$(bench_sqlite "SELECT r.run_id, m.agent_class, COALESCE(r.role, ''),
      COALESCE(r.disposition, 'ABSENT'), COALESCE(r.scored_at, '')
    FROM runs r JOIN models m ON m.model_id = r.model_id
    WHERE r.model_id = '$(printf '%s' "$model_id" | sed "s/'/''/g")'
    ORDER BY r.scored_at DESC, r.run_id;")"
  if [[ -n "$lines" ]]; then
    printf '%s\n' "$lines"
  else
    printf 'ABSENT\n'
  fi
}

bench_run_detail() {
  local run_id=$1 lines
  bench_validate >/dev/null 2>&1 || return 1
  lines="$(bench_sqlite "SELECT r.run_id, r.model_id, m.agent_class,
      COALESCE(r.role, ''), COALESCE(r.campaign, ''),
      COALESCE(r.disposition, 'ABSENT'), COALESCE(r.scored_at, '')
    FROM runs r JOIN models m ON m.model_id = r.model_id
    WHERE r.run_id = '$(printf '%s' "$run_id" | sed "s/'/''/g")' LIMIT 1;")"
  if [[ -n "$lines" ]]; then
    printf '%s\n' "$lines"
  else
    printf 'ABSENT\n'
  fi
}

bench_backlink_lines() {
  local run_id=$1
  bench_validate >/dev/null 2>&1 || return 1
  bench_sqlite "SELECT rl.to_run_id, r.model_id, m.agent_class, rl.link_kind
    FROM run_links rl
    JOIN runs r ON r.run_id = rl.to_run_id
    JOIN models m ON m.model_id = r.model_id
    WHERE rl.from_run_id = '$(printf '%s' "$run_id" | sed "s/'/''/g")'
    ORDER BY rl.link_kind, rl.to_run_id;"
}

case "${1:-}" in
  path)
    bench_validate || exit 1
    printf 'root=%s\n' "$BENCH_ROOT"
    printf 'source=%s\n' "$BENCH_SOURCE"
    printf 'db=%s\n' "$(bench_db)"
    bench_models_index && printf 'models_index=%s\n' "$(bench_models_index)"
    bench_crossref && printf 'crossref=%s\n' "$(bench_crossref)" || true
    exit 0
    ;;
  check)
    if ! bench_validate; then
      exit 1
    fi
    printf 'status=ok\n'
    printf 'source=%s\n' "$BENCH_SOURCE"
    printf 'model_count=%s\n' "$(bench_sqlite 'SELECT COUNT(*) FROM models;')"
    printf 'run_count=%s\n' "$(bench_sqlite 'SELECT COUNT(*) FROM runs;')"
    printf 'backlink_count=%s\n' "$(bench_sqlite 'SELECT COUNT(*) FROM run_links;')"
    exit 0
    ;;
  models)
    bench_validate || exit 1
    bench_models_lines
    exit 0
    ;;
  runs)
    [[ -n "${2:-}" ]] || {
      printf 'Usage: cockpit-bench runs MODEL_ID\n' >&2
      exit 2
    }
    bench_validate || exit 1
    bench_runs_lines "$2"
    exit 0
    ;;
  show-run)
    [[ -n "${2:-}" ]] || {
      printf 'Usage: cockpit-bench show-run RUN_ID\n' >&2
      exit 2
    }
    bench_validate || exit 1
    bench_run_detail "$2"
    bench_backlink_lines "$2" | while IFS=$'\t' read -r to_run model agent_class kind; do
      [[ -n "$to_run" ]] || continue
      printf 'backlink\t%s\t%s\t%s\t%s\n' "$to_run" "$model" "$agent_class" "$kind"
    done
    exit 0
    ;;
esac

once=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --once) once=1 ;;
    -h|--help)
      cat <<'EOF'
Usage: cockpit-bench [path|check|models|runs MODEL_ID|show-run RUN_ID] [--once]

Interactive ghui drill (default in Cockpit BENCH pane):
  L1 models → L2 runs → L3 run+backlinks
  Enter drills down; Enter on backlink jumps peer run; Esc pops stack.
Read-only. Proctor is the sole writer. Never invents scores (ABSENT fail-closed).
EOF
      exit 0
      ;;
    *)
      printf 'Usage: cockpit-bench [path|check|models|runs MODEL_ID|show-run RUN_ID] [--once]\n' >&2
      exit 2
      ;;
  esac
  shift
done

bench_render_absent() {
  clear_screen
  printf '%sBENCH%s  %sABSENT%s\n\n' \
    "$(cockpit_theme_heading)" "$(cockpit_theme_reset)" \
    "$(cockpit_theme_style accent '' 1)" "$(cockpit_theme_reset)"
  printf 'BENCH unavailable: Proctor bench receipt is missing or incomplete.\n'
  printf 'Expected a readable ~/intercom/proctor/ mirror with db/runs.sqlite.\n'
  printf 'Cockpit does not write scores; Proctor is the sole writer.\n'
}

bench_drill_once() {
  if ! bench_validate >/dev/null 2>&1; then
    bench_render_absent
    return 1
  fi
  local display_root="$BENCH_ROOT"
  # Keep stdin attached to the pane so curses can receive keys; fd 3 carries
  # the embedded UI source separately.
  python3 /dev/fd/3 "$BENCH_ROOT" "$(bench_db)" "$display_root" 3<<'PY'
import curses
import os
import sqlite3
import sys

ROOT, DB, DISPLAY_ROOT = sys.argv[1], sys.argv[2], sys.argv[3]

NAV_LEFT = "cockpit · MEMORY  COMPUTERS  MODELS  BENCH  FILES  PRS"
NAV_RIGHT = "BENCH  ghui  read-only"


def connect():
    conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def display_data_path(path):
    home = os.path.expanduser("~")
    if path.startswith(home):
        return "~" + path[len(home) :]
    return path


def fetch_models(conn):
    cur = conn.execute(
        "SELECT model_id, model_id AS name, agent_class FROM models ORDER BY model_id"
    )
    return [(r["model_id"], r["name"], r["agent_class"]) for r in cur.fetchall()]


def fetch_runs(conn, model_id):
    cur = conn.execute(
        """SELECT run_id, model_id,
                  COALESCE(role, '') AS role,
                  COALESCE(campaign, '') AS campaign,
                  COALESCE(disposition, 'ABSENT') AS status,
                  COALESCE(scored_at, '') AS scored_at
           FROM runs WHERE model_id = ? ORDER BY scored_at DESC, run_id""",
        (model_id,),
    )
    return [dict(r) for r in cur.fetchall()]


def fetch_run(conn, run_id):
    cur = conn.execute(
        """SELECT r.run_id, r.model_id, m.agent_class,
                  COALESCE(role, '') AS role,
                  COALESCE(campaign, '') AS campaign,
                  COALESCE(disposition, 'ABSENT') AS status,
                  COALESCE(scored_at, '') AS scored_at
           FROM runs r JOIN models m ON m.model_id = r.model_id
           WHERE r.run_id = ? LIMIT 1""",
        (run_id,),
    )
    row = cur.fetchone()
    return dict(row) if row else None


def fetch_backlinks(conn, run_id):
    cur = conn.execute(
        """SELECT rl.to_run_id, rl.link_kind, r.model_id
           FROM run_links rl JOIN runs r ON r.run_id = rl.to_run_id
           WHERE rl.from_run_id = ? ORDER BY rl.link_kind, rl.to_run_id""",
        (run_id,),
    )
    return [dict(r) for r in cur.fetchall()]


def model_site(conn, model_id):
    row = conn.execute(
        "SELECT agent_class FROM models WHERE model_id = ? LIMIT 1", (model_id,)
    ).fetchone()
    if not row or not row[0]:
        return "ABSENT"
    agent_class = str(row[0])
    if agent_class == "local":
        return "local"
    if "frontier" in agent_class:
        return "frontier"
    return agent_class


def truncate_run_id(run_id, width=12):
    if len(run_id) <= width:
        return run_id
    return run_id[:8] + "..."


def init_colors():
    if not curses.has_colors():
        return None
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)      # selection cursor
    curses.init_pair(2, curses.COLOR_YELLOW, -1)    # backlink header / chips
    curses.init_pair(3, curses.COLOR_WHITE, -1)     # default text
    curses.init_pair(4, 8, -1)                      # dim / muted (bright black)
    return {
        "sel": curses.color_pair(1),
        "yellow": curses.color_pair(2),
        "dim": curses.color_pair(4),
        "bold": curses.A_BOLD,
    }


def clip(text, width):
    if width <= 0:
        return ""
    return text[: max(0, width - 1)]


def draw_top_chrome(stdscr, width, colors):
    left = clip(NAV_LEFT, max(1, width - len(NAV_RIGHT) - 2))
    stdscr.addstr(0, 0, left, colors["dim"] if colors else 0)
    stdscr.addstr(0, max(0, width - len(NAV_RIGHT)), NAV_RIGHT, colors["bold"] if colors else curses.A_BOLD)


def draw_footer(stdscr, height, width, colors):
    line = (
        f"t524u ghui  ·  Esc=pop  Enter=drill/backlink  ·  "
        f"data: {display_data_path(DISPLAY_ROOT)}/  ·  writer: Proctor"
    )
    stdscr.addstr(height - 1, 0, clip(line, width), colors["dim"] if colors else 0)


def column_bounds(width):
    c1 = width // 3
    c2 = (width * 2) // 3
    return c1, c2


def draw_vrules(stdscr, top, bottom, c1, c2, colors):
    attr = colors["dim"] if colors else 0
    for row in range(top, bottom):
        stdscr.addch(row, c1, "|", attr)
        stdscr.addch(row, c2, "|", attr)


def draw_models_col(stdscr, conn, models, model_idx, focus_col, x0, x1, y0, y1, colors):
    stdscr.addstr(y0, x0 + 1, "Models", colors["bold"] if colors else curses.A_BOLD)
    row = y0 + 2
    for i, item in enumerate(models):
        if row >= y1 - 1:
            break
        mid = item[0]
        agent_class = item[2] if len(item) > 2 else ""
        if "frontier" in str(agent_class):
            site = "frontier"
        elif str(agent_class) == "local":
            site = "local"
        else:
            site = model_site(conn, mid)
        cursor = ">" if focus_col == 0 and i == model_idx else " "
        site_attr = colors["dim"] if site == "ABSENT" and colors else 0
        if focus_col == 0 and i == model_idx and colors:
            stdscr.addstr(row, x0 + 1, cursor, colors["sel"] | curses.A_BOLD)
        else:
            stdscr.addstr(row, x0 + 1, cursor)
        name_w = max(8, (x1 - x0) - len(site) - 4)
        stdscr.addstr(row, x0 + 3, clip(mid, name_w))
        stdscr.addstr(row, x1 - len(site) - 1, site, site_attr)
        row += 1


def draw_runs_col(stdscr, runs, model_id, run_idx, focus_col, x0, x1, y0, y1, colors):
    title = f"Runs — {model_id}" if model_id else "Runs"
    stdscr.addstr(y0, x0 + 1, clip(title, x1 - x0 - 2), colors["bold"] if colors else curses.A_BOLD)
    row = y0 + 2
    if not model_id:
        stdscr.addstr(row, x0 + 1, "ABSENT", colors["dim"] if colors else 0)
        return
    if not runs:
        stdscr.addstr(row, x0 + 1, "ABSENT", colors["dim"] if colors else 0)
        return
    for i, run in enumerate(runs):
        if row >= y1 - 2:
            break
        cursor = ">" if focus_col == 1 and i == run_idx else " "
        if focus_col == 1 and i == run_idx and colors:
            stdscr.addstr(row, x0 + 1, cursor, colors["sel"] | curses.A_BOLD)
        else:
            stdscr.addstr(row, x0 + 1, cursor)
        stdscr.addstr(row, x0 + 3, clip(run["run_id"], x1 - x0 - 4))
        row += 1
        status = run.get("status") or "ABSENT"
        stdscr.addstr(row, x0 + 3, clip(status, x1 - x0 - 4), colors["dim"] if colors else 0)
        row += 1


def draw_backlink_chip(stdscr, y, x, w, kind, run_id, selected, colors):
    label = clip(kind or "backlink", w - 4)
    rid = truncate_run_id(run_id, max(8, w - 6))
    attr = colors["yellow"] if colors else 0
    if selected and colors:
        attr |= curses.A_BOLD
    top = "┌" + "-" * (w - 2) + "┐"
    mid1 = "|" + label.center(max(1, w - 2))[: w - 2].ljust(w - 2) + "|"
    mid2 = "|" + rid.center(max(1, w - 2))[: w - 2].ljust(w - 2) + "|"
    bot = "└" + "-" * (w - 2) + "┘"
    for i, line in enumerate((top, mid1, mid2, bot)):
        stdscr.addstr(y + i, x, clip(line, w), attr)


def draw_detail_col(stdscr, run, backlinks, bl_idx, focus_col, x0, x1, y0, y1, colors):
    stdscr.addstr(y0, x0 + 1, "Run + backlinks", colors["bold"] if colors else curses.A_BOLD)
    row = y0 + 2
    if not run:
        stdscr.addstr(row, x0 + 1, "ABSENT", colors["dim"] if colors else 0)
        return
    stdscr.addstr(row, x0 + 1, "run_id (selected)", colors["dim"] if colors else 0)
    row += 1
    stdscr.addstr(row, x0 + 1, clip(run["run_id"], x1 - x0 - 2))
    row += 1
    metadata = " · ".join(
        value
        for value in (
            run.get("model_id"),
            run.get("agent_class"),
            run.get("role"),
            run.get("campaign"),
            run.get("status"),
        )
        if value
    )
    if metadata:
        stdscr.addstr(row, x0 + 1, clip(metadata, x1 - x0 - 2), colors["dim"] if colors else 0)
        row += 1
    row += 1
    stdscr.addstr(row, x0 + 1, "Backlinks (Enter → jump)", colors["yellow"] if colors else 0)
    row += 2
    if not backlinks:
        stdscr.addstr(row, x0 + 1, "ABSENT", colors["dim"] if colors else 0)
        return
    chip_w = min(22, max(14, x1 - x0 - 4))
    for i, link in enumerate(backlinks):
        if row + 4 >= y1:
            break
        selected = focus_col == 2 and i == bl_idx
        draw_backlink_chip(
            stdscr,
            row,
            x0 + 1,
            chip_w,
            link.get("link_kind") or "backlink",
            link["to_run_id"],
            selected,
            colors,
        )
        row += 5


def main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    colors = init_colors()
    conn = connect()
    models = fetch_models(conn)
    model_idx = 0
    run_idx = 0
    bl_idx = 0
    focus_col = 0
    jump_stack = []

    def current_model():
        return models[model_idx][0] if models else None

    def current_runs():
        mid = current_model()
        return fetch_runs(conn, mid) if mid else []

    def current_run_id():
        runs = current_runs()
        if not runs or run_idx >= len(runs):
            return None
        return runs[run_idx]["run_id"]

    def sync_run_bounds():
        nonlocal run_idx
        runs = current_runs()
        if not runs:
            run_idx = 0
            return
        if run_idx >= len(runs):
            run_idx = max(0, len(runs) - 1)

    def select_run_by_id(run_id):
        nonlocal model_idx, run_idx, focus_col
        runs = current_runs()
        for i, run in enumerate(runs):
            if run["run_id"] == run_id:
                run_idx = i
                focus_col = 1
                return True
        run = fetch_run(conn, run_id)
        if not run:
            return False
        for i, row in enumerate(models):
            mid = row[0]
            if mid == run["model_id"]:
                model_idx = i
                break
        runs = current_runs()
        for i, r in enumerate(runs):
            if r["run_id"] == run_id:
                run_idx = i
                focus_col = 1
                return True
        return False

    while True:
        height, width = stdscr.getmaxyx()
        body_top = 2
        body_bottom = height - 2
        c1, c2 = column_bounds(width)
        stdscr.erase()
        draw_top_chrome(stdscr, width, colors)
        stdscr.hline(1, 0, "-", width)
        draw_vrules(stdscr, body_top, body_bottom, c1, c2, colors)

        model_id = current_model()
        runs = current_runs()
        sync_run_bounds()
        run_id = current_run_id()
        run = fetch_run(conn, run_id) if run_id else None
        backlinks = fetch_backlinks(conn, run_id) if run_id else []

        draw_models_col(stdscr, conn, models, model_idx, focus_col, 0, c1, body_top, body_bottom, colors)
        draw_runs_col(stdscr, runs, model_id, run_idx, focus_col, c1 + 1, c2, body_top, body_bottom, colors)
        draw_detail_col(stdscr, run, backlinks, bl_idx, focus_col, c2 + 1, width, body_top, body_bottom, colors)
        draw_footer(stdscr, height, width, colors)
        stdscr.refresh()

        key = stdscr.getch()
        if key in (ord("q"), ord("Q")):
            return 0
        if key == 27:  # Esc
            if jump_stack:
                prev = jump_stack.pop()
                select_run_by_id(prev)
            elif focus_col > 0:
                focus_col -= 1
            continue
        if key in (curses.KEY_RIGHT, ord("\t"), 9):
            focus_col = min(2, focus_col + 1)
            continue
        if key == curses.KEY_LEFT:
            focus_col = max(0, focus_col - 1)
            continue
        if key in (curses.KEY_UP, ord("k")):
            if focus_col == 0 and model_idx > 0:
                model_idx -= 1
                run_idx = 0
                bl_idx = 0
            elif focus_col == 1 and run_idx > 0:
                run_idx -= 1
                bl_idx = 0
            elif focus_col == 2 and bl_idx > 0:
                bl_idx -= 1
            continue
        if key in (curses.KEY_DOWN, ord("j")):
            if focus_col == 0 and model_idx < len(models) - 1:
                model_idx += 1
                run_idx = 0
                bl_idx = 0
            elif focus_col == 1 and run_idx < len(runs) - 1:
                run_idx += 1
                bl_idx = 0
            elif focus_col == 2 and bl_idx < len(backlinks) - 1:
                bl_idx += 1
            continue
        if key in (10, 13, curses.KEY_ENTER):
            if focus_col == 0:
                focus_col = 1
            elif focus_col == 1:
                focus_col = 2
            elif focus_col == 2 and backlinks and bl_idx < len(backlinks):
                peer = backlinks[bl_idx]["to_run_id"]
                if run_id:
                    jump_stack.append(run_id)
                select_run_by_id(peer)
                bl_idx = 0
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(curses.wrapper(main))
PY
}

clear_screen() {
  printf '\033[2J\033[H'
}

if ((once)); then
  if ! bench_validate >/dev/null 2>&1; then
    bench_render_absent
    exit 1
  fi
  bench_drill_once
  exit 0
fi

session="$(tmux display-message -p '#{session_name}' 2>/dev/null || echo unknown)"
COCKPIT_DEBOUNCE=0.25

maybe_render() {
  if cockpit_view_visible; then
    bench_interactive_session
  fi
}

if [[ "$session" == unknown ]]; then
  printf 'BENCH idle: open the Cockpit BENCH page from the managed session.\n'
  while true; do sleep 3600; done
fi

cockpit_event_open "$session" BENCH
trap 'cockpit_event_close; rm -f "$(cockpit_wake_dir "$session")/BENCH.pid"' EXIT

bench_idle_message() {
  clear_screen
  printf '%sBENCH%s  idle\n\n' \
    "$(cockpit_theme_heading)" "$(cockpit_theme_reset)"
  printf 'Open the BENCH page or press a wake to render the Proctor bench drill.\n'
}

bench_interactive_session() {
  if ! bench_validate >/dev/null 2>&1; then
    bench_render_absent
    return 0
  fi
  bench_drill_once || true
}

if cockpit_view_visible; then
  bench_interactive_session
else
  bench_idle_message
fi

bench_validate >/dev/null 2>&1 || true
watch_dir="${BENCH_ROOT:-}"
if [[ -z "$watch_dir" ]]; then
  watch_dir="${COCKPIT_PROCTOR_HOME:-${COCKPIT_INTERCOM_HOME:-$HOME/intercom}/proctor}"
fi

cockpit_event_watch "$watch_dir" \
  -e close_write,moved_to,create,delete \
  --exclude "$cockpit_noise_exclude"

while cockpit_event_read; do
  case "$COCKPIT_EVENT" in
    QUIT) exit 0 ;;
    WAKE) maybe_render; continue ;;
  esac
  sleep "$COCKPIT_DEBOUNCE"
  maybe_render
done
