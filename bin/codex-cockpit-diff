#!/usr/bin/env bash
set -euo pipefail

lib="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/codex-cockpit-lib"
# shellcheck source=codex-cockpit-lib
source "$lib"

root="${1:-$PWD}"
root="$(cd -- "$root" && pwd -P)"
session="$(tmux display-message -p '#{session_name}' 2>/dev/null || echo unknown)"
COCKPIT_DEBOUNCE=0.45

export GIT_PAGER=cat PAGER=cat LESS=FRX

# Only a real project Git root is cheap and live-accurate. An empty $HOME
# worktree would make every nested file look untracked and force a full dump
# on each event.
use_git=0
git_root="$root"
scope="."
if [[ -d "$root/.git" ]]; then
  use_git=1
  git_root="$root"
else
  project_root="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$project_root" ]]; then
    project_root="$(cd -- "$project_root" && pwd -P)"
    if [[ "$project_root" != "$HOME" ]]; then
      use_git=1
      git_root="$project_root"
      if [[ "$root" != "$git_root" ]]; then
        scope="${root#"$git_root"/}"
      fi
    fi
  fi
fi

git_cmd=(git -C "$git_root" --no-pager -c core.pager=cat)

last_fp=""
dirty=1
recent=()

clear_screen() {
  printf '\033[2J\033[H'
}

remember() {
  local path=$1 i
  cockpit_is_noise_path "$path" && return 0
  [[ -e "$path" || ! -e "$path" ]] || return 0
  for i in "${recent[@]+"${recent[@]}"}"; do
    [[ "$i" == "$path" ]] && return 0
  done
  recent=("$path" "${recent[@]+"${recent[@]}"}")
  if ((${#recent[@]} > 16)); then
    recent=("${recent[@]:0:16}")
  fi
}

fingerprint() {
  if ((use_git == 1)); then
    "${git_cmd[@]}" status --porcelain --untracked-files=normal -- "$scope" 2>/dev/null || true
    "${git_cmd[@]}" diff --stat -- "$scope" 2>/dev/null || true
    "${git_cmd[@]}" diff --cached --stat -- "$scope" 2>/dev/null || true
    return 0
  fi
  if ((${#recent[@]})); then
    cockpit_fingerprint_files "$root" "${recent[@]}"
  else
    printf 'clean\n'
  fi
}

render() {
  local fp status tracked_diff staged_diff file count

  fp="$(fingerprint)"
  if [[ "$fp" == "$last_fp" && -n "$last_fp" ]]; then
    dirty=0
    return 0
  fi
  last_fp=$fp
  dirty=0

  clear_screen
  printf '\033[38;5;4mDIFF\033[0m  %s\n' "$root"
  printf '\033[38;5;8mIdle until edits  ·  refreshes when this tab is visible\033[0m\n\n'

  if ((use_git == 1)); then
    status="$("${git_cmd[@]}" status --porcelain --untracked-files=normal -- "$scope" 2>/dev/null || true)"
    if [[ -z "$status" ]]; then
      printf 'Working tree clean.\n'
      printf '\nCodex writes in this project will show here.\n'
      return 0
    fi
    printf '\033[1;37mFILES\033[0m\n%s\n\n' "$(printf '%s\n' "$status" | sed -n '1,60p')"
    tracked_diff="$("${git_cmd[@]}" diff --no-ext-diff --color=always --unified=2 -- "$scope" 2>/dev/null || true)"
    staged_diff="$("${git_cmd[@]}" diff --cached --no-ext-diff --color=always --unified=2 -- "$scope" 2>/dev/null || true)"
    if [[ -n "$staged_diff" || -n "$tracked_diff" ]]; then
      printf '\033[1;37mPATCH\033[0m\n'
      [[ -n "$staged_diff" ]] && printf '%s\n' "$staged_diff"
      [[ -n "$tracked_diff" ]] && printf '%s\n' "$tracked_diff"
    fi
    return 0
  fi

  printf 'Project is not its own Git repo. Recent writes:\n\n'
  if ((${#recent[@]} == 0)); then
    printf 'Waiting for the first edit.\n'
    return 0
  fi
  count=0
  for file in "${recent[@]}"; do
    count=$((count + 1))
    if ((count > 12)); then
      break
    fi
    if [[ -f "$file" ]]; then
      printf 'M  %s\n' "${file#"$root"/}"
    else
      printf 'D  %s\n' "${file#"$root"/}"
    fi
  done
}

maybe_render() {
  if cockpit_view_visible; then
    render
  else
    dirty=1
  fi
}

cockpit_install_wake "$session" DIFF
trap 'rm -f "$(cockpit_wake_dir "$session")/DIFF.pid"' EXIT

if ((use_git == 0)); then
  mapfile -t recent < <(
    find "$root" -maxdepth 3 -type f \
      ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/.cache/*' \
      -printf '%T@ %p\n' 2>/dev/null |
      sort -nr | head -n 12 | while IFS= read -r line; do
        printf '%s\n' "${line#* }"
      done
  ) || true
fi

if [[ "$root" == "$HOME" ]]; then
  printf 'Refusing to watch $HOME.\n'
  while true; do sleep 3600; done
fi

if cockpit_view_visible; then
  render
else
  dirty=1
  printf '\033[2J\033[H'
  printf '\033[38;5;4mDIFF\033[0m  idle\n\n'
  printf 'Patch view refreshes when you open this tab.\n'
fi

if ! command -v inotifywait >/dev/null 2>&1; then
  printf '\nNo inotify; sleeping. Open this tab after edits.\n'
  while true; do
    if ((COCKPIT_WAKE == 1)); then
      COCKPIT_WAKE=0
      maybe_render
    fi
    sleep 5
  done
fi

while true; do
  if IFS= read -r -t 0.5 event; then
    if [[ -n "$event" ]] && ! cockpit_is_noise_path "$event"; then
      remember "${event}"
    fi
    cockpit_coalesce
    while IFS= read -r -t 0.01 extra; do
      if [[ -n "$extra" ]] && ! cockpit_is_noise_path "$extra"; then
        remember "$extra"
      fi
    done || true
    maybe_render
  else
    if ((COCKPIT_WAKE == 1)); then
      COCKPIT_WAKE=0
      last_fp=""
      maybe_render
    fi
  fi
done < <(
  inotifywait -m -q -r \
    -e close_write,moved_to,create,delete,move \
    --exclude "$cockpit_noise_exclude" \
    --format '%w%f' \
    "$root" 2>/dev/null
)
